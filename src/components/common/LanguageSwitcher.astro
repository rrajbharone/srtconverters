---
import { LOCALES, type Locale, LOCALE_INFO } from '@/i18n/config';
import { type RouteId, getRoutePath } from '@/i18n/routes';
import { getUiStrings } from '@/i18n/utils';

interface Props {
  currentLocale: Locale;
  routeId: RouteId | '404';
}

const { currentLocale, routeId } = Astro.props;
const currentInfo = LOCALE_INFO[currentLocale];
const ui = getUiStrings(currentLocale);

// Calculate destination URL for each supported language
const languageOptions = LOCALES.map((loc) => {
  const info = LOCALE_INFO[loc];
  const targetUrl = routeId !== '404' ? getRoutePath(routeId, loc) : getRoutePath('home', loc);
  return {
    code: loc,
    name: info.name,
    nativeName: info.nativeName,
    url: targetUrl,
    isActive: loc === currentLocale,
  };
});
---

<div class="lang-dropdown-wrapper" id="lang-switcher">
  <button
    type="button"
    class="lang-btn"
    id="lang-menu-btn"
    aria-haspopup="true"
    aria-expanded="false"
    aria-label={ui.nav.selectLanguage}
    title={ui.nav.selectLanguage}
  >
    <!-- Globe Icon (always visible on mobile & desktop) -->
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="2" y1="12" x2="22" y2="12"></line>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
    </svg>
    <span class="lang-name-text">{currentInfo.nativeName}</span>
    <svg class="lang-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <div class="lang-menu" id="lang-dropdown-menu" role="menu">
    {languageOptions.map((opt) => (
      <a
        href={opt.url}
        class={`lang-option ${opt.isActive ? 'active' : ''}`}
        role="menuitem"
        hreflang={opt.code}
        lang={opt.code}
      >
        <span>{opt.nativeName}</span>
        {opt.isActive && (
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        )}
      </a>
    ))}
  </div>
</div>

<script is:inline>
  (function () {
    const wrapper = document.getElementById('lang-switcher');
    const btn = document.getElementById('lang-menu-btn');
    const menu = document.getElementById('lang-dropdown-menu');

    if (btn && menu && wrapper) {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = menu.classList.contains('open');
        if (isOpen) {
          menu.classList.remove('open');
          btn.setAttribute('aria-expanded', 'false');
        } else {
          menu.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });

      document.addEventListener('click', (e) => {
        if (!wrapper.contains(e.target)) {
          menu.classList.remove('open');
          btn.setAttribute('aria-expanded', 'false');
        }
      });
    }
  })();
</script>
