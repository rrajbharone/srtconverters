---
import type { Locale } from '@/i18n/config';
import { getToolsContent, getUiStrings } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUiStrings(locale);
const tools = getToolsContent(locale);
---

<div class="tool-workspace" id="srt-to-ass-app">
  <div class="privacy-banner">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
      <path d="M9 12l2 2 4-4"></path>
    </svg>
    <span><strong>{ui.privacyNotice.title}:</strong> {ui.privacyNotice.description}</span>
  </div>

  <div class="tool-grid">
    <div class="tool-pane">
      <div class="pane-header">
        <span class="pane-title">SRT Input (.srt)</span>
        <div class="pane-actions">
          <button type="button" class="btn btn-outline btn-sm" id="btn-load-srtass-sample">
            {ui.common.loadSample}
          </button>
          <button type="button" class="btn btn-outline btn-sm" id="btn-clear-srtass-input">
            {ui.common.clear}
          </button>
        </div>
      </div>

      <div class="dropzone-container" id="srtass-dropzone">
        <textarea
          id="srtass-input"
          class="tool-textarea"
          placeholder="1&#10;00:00:01,000 --> 00:00:04,000&#10;Paste SubRip SRT subtitles here..."
          spellcheck="false"
        ></textarea>
        
        <div class="dropzone-overlay">
          <span>{ui.common.dragAndDrop}</span>
          <label for="srtass-file-upload" class="btn btn-secondary btn-sm" style="margin: 0; cursor: pointer;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="17 8 12 3 7 8"></polyline>
              <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
            <span>{ui.common.browseFiles}</span>
          </label>
          <input type="file" id="srtass-file-upload" class="file-input-hidden" accept=".srt,text/plain" />
        </div>
      </div>
    </div>

    <div class="tool-pane">
      <div class="pane-header">
        <span class="pane-title">ASS Output (.ass)</span>
        <div class="pane-actions">
          <button type="button" class="btn btn-outline btn-sm" id="btn-copy-ass" disabled>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="copy-ass-btn-text">{ui.common.copy}</span>
          </button>
          <button type="button" class="btn btn-primary btn-sm" id="btn-download-ass" disabled>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>{ui.common.download.replace('.SRT', '.ASS').replace('.srt', '.ass')}</span>
          </button>
        </div>
      </div>

      <textarea
        id="ass-output"
        class="tool-textarea"
        readonly
        placeholder="[Script Info]&#10;ScriptType: v4.00+&#10;&#10;[V4+ Styles]&#10;...&#10;&#10;[Events]&#10;Dialogue: 0,0:00:01.00,0:00:04.00,Default,,0,0,0,,Converted ASS subtitles will appear here..."
      ></textarea>
    </div>
  </div>
</div>

<script>
  import { convertSrtToAss } from '@/lib/ass-converters';

  function initSrtToAss() {
    const srtInput = document.getElementById('srtass-input') as HTMLTextAreaElement;
    const assOutput = document.getElementById('ass-output') as HTMLTextAreaElement;
    const btnSample = document.getElementById('btn-load-srtass-sample');
    const btnClear = document.getElementById('btn-clear-srtass-input');
    const btnCopy = document.getElementById('btn-copy-ass') as HTMLButtonElement;
    const btnDownload = document.getElementById('btn-download-ass') as HTMLButtonElement;
    const copyBtnText = document.getElementById('copy-ass-btn-text');
    const fileUpload = document.getElementById('srtass-file-upload') as HTMLInputElement;
    const dropzone = document.getElementById('srtass-dropzone');

    const sampleSrt = `1\n00:00:01,000 --> 00:00:04,500\nWelcome to the <i>SRT to ASS Converter</i>!\n\n2\n00:00:04,600 --> 00:00:08,200\nAdvanced SubStation Alpha supports <b>custom styling</b>, colors, and positioning.`;

    function processSrtToAss() {
      if (!srtInput || !assOutput) return;
      const raw = srtInput.value.trim();
      if (!raw) {
        assOutput.value = '';
        if (btnCopy) btnCopy.disabled = true;
        if (btnDownload) btnDownload.disabled = true;
        return;
      }

      const ass = convertSrtToAss(raw);
      assOutput.value = ass;
      if (btnCopy) btnCopy.disabled = !ass;
      if (btnDownload) btnDownload.disabled = !ass;
    }

    srtInput?.addEventListener('input', processSrtToAss);
    btnSample?.addEventListener('click', () => {
      if (srtInput) {
        srtInput.value = sampleSrt;
        processSrtToAss();
      }
    });
    btnClear?.addEventListener('click', () => {
      if (srtInput) {
        srtInput.value = '';
        processSrtToAss();
      }
    });

    fileUpload?.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      const file = target.files?.[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (evt) => {
          if (srtInput && typeof evt.target?.result === 'string') {
            srtInput.value = evt.target.result;
            processSrtToAss();
          }
        };
        reader.readAsText(file);
      }
    });

    if (dropzone) {
      ['dragenter', 'dragover'].forEach((eventName) => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.add('dragover');
        });
      });

      ['dragleave', 'drop'].forEach((eventName) => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.remove('dragover');
        });
      });

      dropzone.addEventListener('drop', (e: DragEvent) => {
        const files = e.dataTransfer?.files;
        if (files && files.length > 0) {
          const reader = new FileReader();
          reader.onload = (evt) => {
            if (srtInput && typeof evt.target?.result === 'string') {
              srtInput.value = evt.target.result;
              processSrtToAss();
            }
          };
          reader.readAsText(files[0]);
        }
      });
    }

    btnCopy?.addEventListener('click', async () => {
      if (!assOutput?.value) return;
      try {
        await navigator.clipboard.writeText(assOutput.value);
        if (copyBtnText) {
          const orig = copyBtnText.innerText;
          copyBtnText.innerText = 'Copied!';
          setTimeout(() => (copyBtnText.innerText = orig), 2000);
        }
      } catch (err) {
        console.error('Copy failed', err);
      }
    });

    btnDownload?.addEventListener('click', () => {
      if (!assOutput?.value) return;
      const blob = new Blob([assOutput.value], { type: 'text/x-ssa;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'subtitles.ass';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });

    if (srtInput && !srtInput.value.trim()) {
      srtInput.value = sampleSrt;
      processSrtToAss();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSrtToAss);
  } else {
    initSrtToAss();
  }
</script>
