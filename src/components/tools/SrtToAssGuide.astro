---
import { type Locale } from '@/i18n/config';
import { getRoutePath } from '@/i18n/routes';
import { getSrtToAssGuideContent } from '@/i18n/srtToAssGuide';
import { getToolsContent } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const guide = getSrtToAssGuideContent(locale);
const tools = getToolsContent(locale);

const txtToSrtUrl = getRoutePath('txt-to-srt', locale);
const srtToTextUrl = getRoutePath('srt-to-text', locale);
const srtToVttUrl = getRoutePath('srt-to-vtt', locale);
const vttToSrtUrl = getRoutePath('vtt-to-srt', locale);

const uiLabels: Record<Locale, {
  feature: string;
  srtBadge: string;
  assBadge: string;
  breakdown: string;
  issue: string;
  cause: string;
  solution: string;
  relatedTools: string;
  helpfulArticles: string;
}> = {
  en: {
    feature: 'Feature',
    srtBadge: 'Original Subtitle (.SRT)',
    assBadge: 'Converted ASS (.ASS)',
    breakdown: 'Conversion Breakdown:',
    issue: 'Issue',
    cause: 'Cause:',
    solution: 'Solution',
    relatedTools: 'Related Subtitle Converter Tools',
    helpfulArticles: 'Helpful Guides & Troubleshooting Articles',
  },
  es: {
    feature: 'Característica',
    srtBadge: 'Subtítulo Original (.SRT)',
    assBadge: 'ASS Convertido (.ASS)',
    breakdown: 'Análisis de la Conversión:',
    issue: 'Problema',
    cause: 'Causa:',
    solution: 'Solución',
    relatedTools: 'Herramientas de Conversión Relacionadas',
    helpfulArticles: 'Guías Útiles y Artículos de Soporte',
  },
  pt: {
    feature: 'Recurso',
    srtBadge: 'Legenda Original (.SRT)',
    assBadge: 'ASS Convertido (.ASS)',
    breakdown: 'Análise da Conversão:',
    issue: 'Problema',
    cause: 'Causa:',
    solution: 'Solução',
    relatedTools: 'Ferramentas de Conversão Relacionadas',
    helpfulArticles: 'Guias Úteis e Artigos de Suporte',
  },
  fr: {
    feature: 'Fonctionnalité',
    srtBadge: 'Sous-titre Original (.SRT)',
    assBadge: 'ASS Converti (.ASS)',
    breakdown: 'Analyse de la Conversion :',
    issue: 'Problème',
    cause: 'Cause :',
    solution: 'Solution',
    relatedTools: 'Outils de Conversion Associés',
    helpfulArticles: 'Guides Pratiques et Articles de Dépannage',
  },
  de: {
    feature: 'Merkmal',
    srtBadge: 'Originale Untertitel (.SRT)',
    assBadge: 'Konvertiertes ASS (.ASS)',
    breakdown: 'Analyse der Konvertierung:',
    issue: 'Problem',
    cause: 'Ursache:',
    solution: 'Lösung',
    relatedTools: 'Verwandte Untertitel-Konverter',
    helpfulArticles: 'Hilfreiche Anleitungen & Artikel',
  },
  id: {
    feature: 'Fitur',
    srtBadge: 'Subtitle Asli (.SRT)',
    assBadge: 'ASS Terkonversi (.ASS)',
    breakdown: 'Detail Konversi:',
    issue: 'Masalah',
    cause: 'Penyebab:',
    solution: 'Solusi',
    relatedTools: 'Alat Konversi Subtitle Terkait',
    helpfulArticles: 'Panduan Bermanfaat & Artikel Solusi',
  },
  tr: {
    feature: 'Özellik',
    srtBadge: 'Orijinal Altyazı (.SRT)',
    assBadge: 'Dönüştürülmüş ASS (.ASS)',
    breakdown: 'Dönüşüm Detayları:',
    issue: 'Sorun',
    cause: 'Neden:',
    solution: 'Çözüm',
    relatedTools: 'İlgili Altyazı Dönüştürme Araçları',
    helpfulArticles: 'Faydalı Rehberler ve Destek Makaleleri',
  },
  it: {
    feature: 'Caratteristica',
    srtBadge: 'Sottotitolo Originale (.SRT)',
    assBadge: 'ASS Convertito (.ASS)',
    breakdown: 'Analisi della Conversione:',
    issue: 'Problema',
    cause: 'Causa:',
    solution: 'Soluzione',
    relatedTools: 'Strumenti di Conversione Correlati',
    helpfulArticles: 'Guide Utili e Articoli di Supporto',
  },
};

const labels = uiLabels[locale] || uiLabels.en;
---

<section class="guide-container">
  <div class="article-prose guide-prose">
    <!-- Introduction -->
    <div class="guide-intro-card">
      <h2>{guide.introTitle}</h2>
      <p class="guide-lead-text">{guide.introSubtitle}</p>
      {guide.introText.map((p) => (
        <p>{p}</p>
      ))}
    </div>

    <hr class="guide-divider" />

    <!-- What Is an SRT to ASS Converter? -->
    <section>
      <h2>{guide.whatIsTitle}</h2>
      {guide.whatIsText.map((p) => (
        <p>{p}</p>
      ))}
    </section>

    <hr class="guide-divider" />

    <!-- Why Convert SRT to ASS? -->
    <section>
      <h2>{guide.whyConvertTitle}</h2>
      <p class="guide-lead-text">{guide.whyConvertSubtitle}</p>
      <div class="guide-cards-grid">
        {guide.whyConvertReasons.map((r) => (
          <div class="guide-feature-box">
            <h3>{r.title}</h3>
            <p>{r.description}</p>
          </div>
        ))}
      </div>
    </section>

    <hr class="guide-divider" />

    <!-- How to Convert SRT to ASS Online -->
    <section>
      <h2>{guide.howToTitle}</h2>
      <p>{guide.howToSubtitle}</p>
      <div class="guide-steps-list">
        {guide.howToSteps.map((s) => (
          <div class="guide-step-item">
            <div class="guide-step-badge">{s.step}</div>
            <div class="guide-step-body">
              <h3>{s.title}</h3>
              <p>{s.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <hr class="guide-divider" />

    <!-- Difference Between SRT and ASS -->
    <section>
      <h2>{guide.differenceTitle}</h2>
      <p>{guide.differenceSubtitle}</p>

      <div class="guide-table-wrapper">
        <table class="guide-table">
          <thead>
            <tr>
              <th>{labels.feature}</th>
              <th>SubRip Subtitles (.SRT)</th>
              <th>Advanced SubStation Alpha (.ASS)</th>
            </tr>
          </thead>
          <tbody>
            {guide.differenceTable.map((row) => (
              <tr>
                <td><strong>{row.feature}</strong></td>
                <td>{row.srt}</td>
                <td><span class="badge-inline">{row.ass}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <hr class="guide-divider" />

    <!-- Inside an ASS File: Structure -->
    <section>
      <h2>{guide.structureTitle}</h2>
      <p>{guide.structureSubtitle}</p>

      <div class="structure-blocks-container">
        {guide.structureBlocks.map((block) => (
          <div class="structure-card">
            <h3>{block.name}</h3>
            <p>{block.description}</p>
            <div class="code-box">
              <pre class="code-content"><code>{block.snippet}</code></pre>
            </div>
          </div>
        ))}
      </div>
    </section>

    <hr class="guide-divider" />

    <!-- SRT to ASS Example: Before & After -->
    <section>
      <h2>{guide.exampleTitle}</h2>
      <p>{guide.exampleIntro}</p>

      <div class="code-compare-grid">
        <div class="code-box">
          <div class="code-box-header">
            <span class="code-badge srt-badge">{labels.srtBadge}</span>
          </div>
          <pre class="code-content"><code>{guide.exampleSrtInput}</code></pre>
        </div>

        <div class="code-box">
          <div class="code-box-header">
            <span class="code-badge ass-badge">{labels.assBadge}</span>
          </div>
          <pre class="code-content"><code>{guide.exampleAssOutput}</code></pre>
        </div>
      </div>

      <div class="guide-callout info">
        <p><strong>{labels.breakdown}</strong> {guide.exampleExplanation}</p>
      </div>
    </section>

    <hr class="guide-divider" />

    <!-- Advanced ASS Styling Tags Reference -->
    <section>
      <h2>{guide.featuresTitle}</h2>
      <p>{guide.featuresSubtitle}</p>

      <div class="tags-grid">
        {guide.assFeatures.map((feat) => (
          <div class="tag-card">
            <div class="tag-header">
              <h3>{feat.name}</h3>
              <code class="tag-syntax">{feat.tag}</code>
            </div>
            <p>{feat.explanation}</p>
          </div>
        ))}
      </div>
    </section>

    <hr class="guide-divider" />

    <!-- FFmpeg Command-Line Conversion -->
    <section>
      <h2>{guide.ffmpegTitle}</h2>
      <p>{guide.ffmpegSubtitle}</p>

      <div class="terminal-box">
        <div class="terminal-header">
          <span class="terminal-dot"></span>
          <span class="terminal-dot"></span>
          <span class="terminal-dot"></span>
          <span class="terminal-title">FFmpeg Terminal Command</span>
        </div>
        <pre class="terminal-code"><code>{guide.ffmpegCommand}</code></pre>
      </div>

      {guide.ffmpegExplanation.map((p) => (
        <p>{p}</p>
      ))}
    </section>

    <hr class="guide-divider" />

    <!-- Common Use Cases -->
    <section>
      <h2>{guide.useCasesTitle}</h2>
      <p class="guide-lead-text">{guide.useCasesSubtitle}</p>

      <div class="guide-cards-grid">
        {guide.useCasesList.map((u) => (
          <div class="guide-feature-box">
            <h3>{u.title}</h3>
            <p>{u.description}</p>
          </div>
        ))}
      </div>
    </section>

    <hr class="guide-divider" />

    <!-- Troubleshooting Common Problems -->
    <section>
      <h2>{guide.troubleshootTitle}</h2>
      <p>{guide.troubleshootSubtitle}</p>

      <div class="troubleshoot-grid">
        {guide.troubleshootTips.map((tip) => (
          <div class="troubleshoot-card">
            <div class="troubleshoot-problem">
              <span class="indicator-tag">{labels.issue}</span>
              <h3>{tip.issue}</h3>
            </div>
            <p class="problem-cause"><strong>{labels.cause}</strong> {tip.cause}</p>
            <div class="troubleshoot-solution">
              <span class="indicator-tag fix">{labels.solution}</span>
              <p>{tip.solution}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <hr class="guide-divider" />

    <!-- Subtitle Timing & Audio Sync -->
    <section>
      <h2>{guide.timingTitle}</h2>
      {guide.timingText.map((p) => (
        <p>{p}</p>
      ))}
    </section>

    <hr class="guide-divider" />

    <!-- How to Edit in Aegisub -->
    <section>
      <h2>{guide.aegisubTitle}</h2>
      <p>{guide.aegisubSubtitle}</p>
      <ol class="aegisub-steps-list">
        {guide.aegisubSteps.map((step) => (
          <li>{step}</li>
        ))}
      </ol>
    </section>

    <hr class="guide-divider" />

    <!-- Conclusion & Internal Links -->
    <section class="guide-conclusion-card">
      <h2>{guide.conclusionTitle}</h2>
      {guide.conclusionText.map((p) => (
        <p>{p}</p>
      ))}

      <div class="related-tools-box">
        <h3>{labels.relatedTools}</h3>
        <ul class="related-links-list">
          <li>
            <a href={txtToSrtUrl}><strong>{tools.txtToSrt.name}</strong></a> – {tools.txtToSrt.tagline}
          </li>
          <li>
            <a href={srtToTextUrl}><strong>{tools.srtToText.name}</strong></a> – {tools.srtToText.tagline}
          </li>
          <li>
            <a href={srtToVttUrl}><strong>{tools.srtToVtt.name}</strong></a> – {tools.srtToVtt.tagline}
          </li>
          <li>
            <a href={vttToSrtUrl}><strong>{tools.vttToSrt.name}</strong></a> – {tools.vttToSrt.tagline}
          </li>
        </ul>
      </div>

      <div class="related-tools-box" style="margin-top: 1rem;">
        <h3>{labels.helpfulArticles}</h3>
        <ul class="related-links-list">
          <li>
            <a href="/blog/how-to-convert-srt-to-ass-without-losing-formatting/"><strong>How to Convert SRT to ASS Without Losing Formatting</strong></a> – Complete guide to style preservation and Aegisub setup.
          </li>
          <li>
            <a href="/blog/srt-to-ass-why-subtitle-styles-positioning-get-lost/"><strong>SRT to ASS: Why Subtitle Styles & Positioning Get Lost</strong></a> – In-depth guide to format limitations and coordinate mapping.
          </li>
          <li>
            <a href="/blog/how-to-fix-srt-subtitle-encoding-problems/"><strong>How to Fix SRT Subtitle Encoding Problems (UTF-8)</strong></a> – Solve corrupted accents and foreign characters.
          </li>
          <li>
            <a href="/blog/can-you-convert-srt-to-vtt-by-renaming/"><strong>Can You Convert Subtitle Files Just by Renaming Them?</strong></a> – Understand why proper syntax conversion is mandatory.
          </li>
        </ul>
      </div>
    </section>
  </div>
</section>

<style>
  .guide-container {
    margin-top: 3.5rem;
    padding-top: 2rem;
  }

  .guide-prose {
    max-width: 960px;
    margin: 0 auto;
    color: var(--text-primary);
  }

  .guide-intro-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 2.25rem;
    margin-bottom: 2rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
  }

  .guide-intro-card h2 {
    margin-top: 0;
    font-size: 1.85rem;
    font-weight: 800;
    line-height: 1.25;
    color: var(--text-primary);
  }

  .guide-lead-text {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    font-weight: 500;
  }

  .guide-divider {
    border: 0;
    height: 1px;
    background: var(--border-color);
    margin: 3rem 0;
  }

  .guide-prose h2 {
    font-size: 1.6rem;
    font-weight: 750;
    margin-top: 2rem;
    margin-bottom: 1rem;
    line-height: 1.3;
    color: var(--text-primary);
  }

  .guide-prose h3 {
    font-size: 1.2rem;
    font-weight: 650;
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .guide-prose p {
    font-size: 1.025rem;
    line-height: 1.75;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
  }

  /* Tables */
  .guide-table-wrapper {
    overflow-x: auto;
    margin: 1.75rem 0;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--bg-card);
  }

  .guide-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.95rem;
  }

  .guide-table th,
  .guide-table td {
    padding: 0.85rem 1.15rem;
    border-bottom: 1px solid var(--border-color);
    vertical-align: middle;
  }

  .guide-table th {
    background: var(--bg-primary);
    font-weight: 650;
    color: var(--text-primary);
    white-space: nowrap;
  }

  .guide-table tr:last-child td {
    border-bottom: none;
  }

  .badge-inline {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    font-size: 0.825rem;
    font-weight: 600;
    border-radius: var(--radius-sm);
    background: rgba(37, 99, 235, 0.1);
    color: #2563eb;
    border: 1px solid rgba(37, 99, 235, 0.2);
  }

  /* Steps List */
  .guide-steps-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 1.5rem 0;
  }

  .guide-step-item {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
  }

  .guide-step-badge {
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: #2563eb;
    color: #ffffff;
    font-weight: 700;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .guide-step-body h3 {
    margin-top: 0;
    margin-bottom: 0.35rem;
  }

  .guide-step-body p {
    margin-bottom: 0;
  }

  /* Cards Grid */
  .guide-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    margin: 1.5rem 0;
  }

  .guide-feature-box {
    padding: 1.35rem;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
  }

  .guide-feature-box h3 {
    margin-top: 0;
    margin-bottom: 0.5rem;
    font-size: 1.15rem;
    color: var(--text-primary);
  }

  .guide-feature-box p {
    margin-bottom: 0;
    font-size: 0.95rem;
  }

  /* Structure Blocks */
  .structure-blocks-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin: 1.5rem 0;
  }

  .structure-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.35rem;
  }

  .structure-card h3 {
    margin-top: 0;
    margin-bottom: 0.5rem;
    color: #2563eb;
  }

  /* Code Comparison */
  .code-compare-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin: 1.5rem 0;
  }

  @media (max-width: 768px) {
    .code-compare-grid {
      grid-template-columns: 1fr;
    }
  }

  .code-box {
    background: #0f172a;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .code-box-header {
    background: #1e293b;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .code-badge {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .code-badge.srt-badge {
    background: rgba(59, 130, 246, 0.2);
    color: #60a5fa;
    border: 1px solid rgba(59, 130, 246, 0.4);
  }

  .code-badge.ass-badge {
    background: rgba(168, 85, 247, 0.2);
    color: #c084fc;
    border: 1px solid rgba(168, 85, 247, 0.4);
  }

  .code-content {
    padding: 1.25rem;
    margin: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #e2e8f0;
    white-space: pre-wrap;
    word-break: break-word;
  }

  /* Tags Grid */
  .tags-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    margin: 1.5rem 0;
  }

  .tag-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.25rem;
  }

  .tag-header {
    margin-bottom: 0.5rem;
  }

  .tag-header h3 {
    margin: 0 0 0.25rem 0;
    font-size: 1.05rem;
  }

  .tag-syntax {
    display: inline-block;
    background: rgba(37, 99, 235, 0.1);
    color: #2563eb;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    font-family: ui-monospace, monospace;
    border: 1px solid rgba(37, 99, 235, 0.2);
  }

  .tag-card p {
    margin: 0;
    font-size: 0.925rem;
  }

  /* Terminal Box */
  .terminal-box {
    background: #090d16;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    margin: 1.5rem 0;
  }

  .terminal-header {
    background: #151d2f;
    padding: 0.5rem 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .terminal-dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: #475569;
  }

  .terminal-dot:nth-child(1) { background: #ef4444; }
  .terminal-dot:nth-child(2) { background: #eab308; }
  .terminal-dot:nth-child(3) { background: #10b981; }

  .terminal-title {
    font-size: 0.75rem;
    color: #94a3b8;
    margin-left: 0.5rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .terminal-code {
    padding: 1.25rem;
    margin: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.95rem;
    color: #38bdf8;
    background: transparent;
  }

  /* Callouts */
  .guide-callout {
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-md);
    margin: 1.5rem 0;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-left: 4px solid #2563eb;
  }

  .guide-callout p {
    margin: 0;
  }

  /* Troubleshooting */
  .troubleshoot-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin: 1.5rem 0;
  }

  @media (max-width: 768px) {
    .troubleshoot-grid {
      grid-template-columns: 1fr;
    }
  }

  .troubleshoot-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.25rem;
  }

  .troubleshoot-problem {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .troubleshoot-problem h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .indicator-tag {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.3);
    text-transform: uppercase;
  }

  .indicator-tag.fix {
