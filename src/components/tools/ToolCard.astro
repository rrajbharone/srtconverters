---
import type { Locale } from '@/i18n/config';
import { type RouteId, getRoutePath } from '@/i18n/routes';
import { getUiStrings } from '@/i18n/utils';

interface Props {
  locale: Locale;
  routeId: RouteId;
  name: string;
  badge: string;
  description: string;
}

const { locale, routeId, name, badge, description } = Astro.props;
const toolUrl = getRoutePath(routeId, locale);
const ui = getUiStrings(locale);
---

<a href={toolUrl} class="tool-card">
  <div>
    <div class="tool-card-header">
      <h3 class="tool-card-title">{name}</h3>
      <span class="badge badge-success">{badge}</span>
    </div>
    <p class="tool-card-desc">{description}</p>
  </div>
  <div class="tool-card-footer">
    <span>{ui.common.howToUse.replace('How to Use', 'Convert').replace('Cómo Utilizar', 'Convertir')}</span>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <line x1="5" y1="12" x2="19" y2="12"></line>
      <polyline points="12 5 19 12 12 19"></polyline>
    </svg>
  </div>
</a>
