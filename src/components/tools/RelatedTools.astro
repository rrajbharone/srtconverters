---
import type { Locale } from '@/i18n/config';
import type { RouteId } from '@/i18n/routes';
import { getToolsContent, getUiStrings } from '@/i18n/utils';
import ToolCard from './ToolCard.astro';

interface Props {
  locale: Locale;
  currentRouteId: RouteId;
}

const { locale, currentRouteId } = Astro.props;
const tools = getToolsContent(locale);
const ui = getUiStrings(locale);

const allToolsList: Array<{ routeId: RouteId; name: string; badge: string; description: string }> = [
  {
    routeId: 'txt-to-srt',
    name: tools.txtToSrt.name,
    badge: tools.txtToSrt.badge,
    description: tools.txtToSrt.description,
  },
  {
    routeId: 'srt-to-text',
    name: tools.srtToText.name,
    badge: tools.srtToText.badge,
    description: tools.srtToText.description,
  },
  {
    routeId: 'srt-to-vtt',
    name: tools.srtToVtt.name,
    badge: tools.srtToVtt.badge,
    description: tools.srtToVtt.description,
  },
  {
    routeId: 'vtt-to-srt',
    name: tools.vttToSrt.name,
    badge: tools.vttToSrt.badge,
    description: tools.vttToSrt.description,
  },
  {
    routeId: 'srt-to-ass',
    name: tools.srtToAss.name,
    badge: tools.srtToAss.badge,
    description: tools.srtToAss.description,
  },
  {
    routeId: 'ass-to-srt',
    name: tools.assToSrt.name,
    badge: tools.assToSrt.badge,
    description: tools.assToSrt.description,
  },
];

const filteredTools = allToolsList.filter((t) => t.routeId !== currentRouteId);
---

<section class="info-section">
  <div class="container">
    <div class="section-heading">
      <h2 class="section-title">{ui.common.relatedTools}</h2>
      <p class="section-subtitle">{tools.directory.subtitle}</p>
    </div>

    <div class="tool-cards-grid">
      {filteredTools.map((tool) => (
        <ToolCard
          locale={locale}
          routeId={tool.routeId}
          name={tool.name}
          badge={tool.badge}
          description={tool.description}
        />
      ))}
    </div>
  </div>
</section>
