---
import type { Locale } from '@/i18n/config';
import { getToolsContent, getUiStrings } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUiStrings(locale);
const tools = getToolsContent(locale);
const tool = tools.supToSrt;
---

<div class="tool-workspace" id="sup-to-srt-app">
  <!-- Privacy Guarantee Alert -->
  <div class="privacy-banner">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
      <path d="M9 12l2 2 4-4"></path>
    </svg>
    <span><strong>{ui.privacyNotice.title}:</strong> {ui.privacyNotice.description}</span>
  </div>

  <!-- Settings Bar -->
  <div class="tool-controls-bar">
    <div class="control-group">
      <label for="ocr-language-select" class="control-label">{tool.settingsLabels.cpsLabel}</label>
      <select id="ocr-language-select" class="control-select" title={tool.settingsLabels.cpsHint}>
        <option value="eng" selected>English (eng)</option>
        <option value="spa">Spanish / Español (spa)</option>
        <option value="fra">French / Français (fra)</option>
        <option value="deu">German / Deutsch (deu)</option>
        <option value="por">Portuguese / Português (por)</option>
        <option value="ita">Italian / Italiano (ita)</option>
        <option value="ind">Indonesian / Bahasa Indonesia (ind)</option>
        <option value="tur">Turkish / Türkçe (tur)</option>
      </select>
    </div>

    <div class="control-checkboxes">
      <label class="control-checkbox-label" title={tool.settingsLabels.startTimeHint}>
        <input type="checkbox" id="preserve-multiline" checked />
        <span>{tool.settingsLabels.startTime}</span>
      </label>

      <label class="control-checkbox-label" title={tool.settingsLabels.maxCharsHint}>
        <input type="checkbox" id="autocorrect-artifacts" checked />
        <span>{tool.settingsLabels.maxCharsPerLine}</span>
      </label>
    </div>
  </div>

  <!-- Error / Alert Banner -->
  <div id="sup-error-banner" class="alert-banner alert-error" style="display: none; margin-bottom: 1.5rem;">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="12" y1="8" x2="12" y2="12"></line>
      <line x1="12" y1="16" x2="12.01" y2="16"></line>
    </svg>
    <span id="sup-error-message"></span>
  </div>

  <!-- Progress Bar & Status -->
  <div id="sup-progress-container" class="progress-box" style="display: none; margin-bottom: 1.5rem;">
    <div class="progress-header">
      <span class="progress-title" id="sup-progress-status">Decoding PGS segments...</span>
      <span class="progress-percentage" id="sup-progress-percent">0%</span>
    </div>
    <div class="progress-bar-track">
      <div class="progress-bar-fill" id="sup-progress-bar" style="width: 0%;"></div>
    </div>
    <div class="progress-actions">
      <button type="button" class="btn btn-outline btn-sm" id="btn-cancel-ocr" style="margin-top: 0.5rem;">
        {ui.common.clear || 'Cancel'}
      </button>
    </div>
  </div>

  <!-- Main Tool Grid -->
  <div class="tool-grid">
    <!-- Left Pane: Input File & Decoded Cue Visual Editor -->
    <div class="tool-pane">
      <div class="pane-header">
        <span class="pane-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
          </svg>
          Blu-ray SUP Input (.sup)
        </span>
        <div class="pane-actions">
          <button type="button" class="btn btn-outline btn-sm" id="btn-load-sample-sup">
            {ui.common.loadSample}
          </button>
          <button type="button" class="btn btn-outline btn-sm" id="btn-reset-sup">
            {ui.common.clear}
          </button>
        </div>
      </div>

      <!-- File Dropzone -->
      <div class="dropzone-container" id="sup-dropzone">
        <div class="sup-dropzone-inner" id="sup-dropzone-inner">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 0.75rem; color: var(--color-primary);">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
          <p class="dropzone-text" style="font-weight: 600; margin-bottom: 0.5rem; color: var(--text-primary);">
            {ui.common.dragAndDrop}
          </p>
          <p class="dropzone-subtext" style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem;">
            Blu-ray PGS (.sup) bitmap subtitle streams
          </p>
          <label for="sup-file-upload" class="btn btn-primary btn-sm" style="margin: 0; cursor: pointer;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="17 8 12 3 7 8"></polyline>
              <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
            <span>{ui.common.browseFiles}</span>
          </label>
          <input type="file" id="sup-file-upload" class="file-input-hidden" accept=".sup,application/octet-stream" />
        </div>

        <!-- Decoded Cues Container (shown once parsed) -->
        <div id="cues-editor-list" class="cues-editor-container" style="display: none;">
          <!-- Cue cards injected dynamically -->
        </div>
      </div>

      <div class="pane-meta" id="sup-input-stats">
        0 {ui.common.characters} | 0 cues
      </div>
    </div>

    <!-- Right Pane: SubRip SRT Output & Action Buttons -->
    <div class="tool-pane">
      <div class="pane-header">
        <span class="pane-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="4 17 10 11 4 5"></polyline>
            <line x1="12" y1="19" x2="20" y2="19"></line>
          </svg>
          SubRip SRT Output (.srt)
        </span>
        <div class="pane-actions">
          <button type="button" class="btn btn-outline btn-sm" id="btn-copy-srt" disabled>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="copy-btn-text">{ui.common.copy}</span>
          </button>
          <button type="button" class="btn btn-primary btn-sm" id="btn-download-srt" disabled>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>{ui.common.download}</span>
          </button>
        </div>
      </div>

      <div class="preview-viewer" id="srt-preview-container">
        <textarea
          id="srt-output-textarea"
          class="tool-textarea"
          placeholder={ui.common.outputPlaceholder}
          spellcheck="false"
        ></textarea>
      </div>

      <div class="pane-meta" id="sup-output-stats">
        0 {ui.common.subtitlesCount} | 00:00:00 {ui.common.estimatedDuration}
      </div>
    </div>
  </div>
</div>

<style>
  .tool-workspace {
    margin-bottom: 2.5rem;
  }

  .tool-controls-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    padding: 1rem 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg, 12px);
    margin-bottom: 1.5rem;
  }

  .control-group {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
  }

  .control-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .control-select {
    padding: 0.45rem 0.75rem;
    font-size: 0.85rem;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md, 8px);
    color: var(--text-primary);
    max-width: 100%;
    min-width: 0;
  }

  .control-checkboxes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-left: auto;
  }

  .control-checkbox-label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
    cursor: pointer;
    user-select: none;
  }

  .control-checkbox-label input[type='checkbox'] {
    cursor: pointer;
  }

  .alert-banner {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.85rem 1.25rem;
    border-radius: var(--radius-md, 8px);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .alert-error {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #ef4444;
  }

  .progress-box {
    padding: 1rem 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg, 12px);
  }

  .progress-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .progress-bar-track {
    width: 100%;
    height: 8px;
    background: var(--bg-secondary);
    border-radius: 9999px;
    overflow: hidden;
  }

  .progress-bar-fill {
    height: 100%;
    background: var(--color-primary);
    transition: width 0.2s ease;
  }

  .sup-dropzone-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2.5rem 1.5rem;
    text-align: center;
    border: 2px dashed var(--border-color);
    border-radius: var(--radius-md, 8px);
    background: var(--bg-secondary);
    min-height: 260px;
    transition: border-color 0.2s, background 0.2s;
  }

  .sup-dropzone-inner.dragover {
    border-color: var(--color-primary);
    background: rgba(59, 130, 246, 0.05);
  }

  .cues-editor-container {
    max-height: 480px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0.75rem;
    background: var(--bg-secondary);
    border-radius: var(--radius-md, 8px);
    border: 1px solid var(--border-color);
  }

  :global(.cue-card) {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md, 8px);
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  :global(.cue-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-muted);
  }

  :global(.cue-time-badge) {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    color: var(--color-primary);
  }

  :global(.cue-preview-canvas) {
    width: 100%;
    max-height: 120px;
    object-fit: contain;
    background: #0f172a;
    border: 1px solid var(--border-color);
    border-radius: 4px;
  }

  :global(.cue-text-input) {
    width: 100%;
    min-height: 48px;
    padding: 0.5rem;
    font-size: 0.875rem;
    font-family: inherit;
    line-height: 1.4;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    color: var(--text-primary);
    resize: vertical;
  }

  :global(.cue-text-input:focus) {
    outline: none;
    border-color: var(--color-primary);
  }

  @media (max-width: 768px) {
    .control-checkboxes {
      margin-left: 0;
      width: 100%;
    }

    .sup-dropzone-inner {
      min-height: 190px;
      padding: 1.5rem 1rem;
    }
  }
</style>

<script>
  import { parseSup, generateSampleSupFile, cuesToSrt, formatSrtTimestamp, type DecodedPgsCue } from '@/lib/sup-parser';

  interface ActiveCueState {
    id: number;
    startMs: number;
    endMs: number;
    text: string;
    width: number;
    height: number;
    rgbaData: Uint8ClampedArray;
  }

  (function initSupConverter() {
    const fileUpload = document.getElementById('sup-file-upload') as HTMLInputElement | null;
    const dropzoneInner = document.getElementById('sup-dropzone-inner');
    const cuesList = document.getElementById('cues-editor-list');
    const srtTextarea = document.getElementById('srt-output-textarea') as HTMLTextAreaElement | null;
    const btnLoadSample = document.getElementById('btn-load-sample-sup');
    const btnReset = document.getElementById('btn-reset-sup');
    const btnCopy = document.getElementById('btn-copy-srt') as HTMLButtonElement | null;
    const btnDownload = document.getElementById('btn-download-srt') as HTMLButtonElement | null;
    const btnCancelOcr = document.getElementById('btn-cancel-ocr');
    const copyBtnText = document.getElementById('copy-btn-text');
    const inputStats = document.getElementById('sup-input-stats');
    const outputStats = document.getElementById('sup-output-stats');
    const errorBanner = document.getElementById('sup-error-banner');
    const errorMessage = document.getElementById('sup-error-message');
    const progressContainer = document.getElementById('sup-progress-container');
    const progressBar = document.getElementById('sup-progress-bar');
    const progressStatus = document.getElementById('sup-progress-status');
    const progressPercent = document.getElementById('sup-progress-percent');
    const ocrLangSelect = document.getElementById('ocr-language-select') as HTMLSelectElement | null;
    const preserveMultilineCheckbox = document.getElementById('preserve-multiline') as HTMLInputElement | null;
    const autocorrectCheckbox = document.getElementById('autocorrect-artifacts') as HTMLInputElement | null;

    let activeCues: ActiveCueState[] = [];
    let isOcrCancelled = false;
    let tesseractWorker: any = null;
    let currentFileName = 'subtitles.srt';

    function showError(msg: string) {
      if (errorBanner && errorMessage) {
        errorMessage.textContent = msg;
        errorBanner.style.display = 'flex';
      }
    }

    function clearError() {
      if (errorBanner) {
        errorBanner.style.display = 'none';
      }
    }

    function updateProgress(percent: number, statusText: string) {
      if (progressContainer && progressBar && progressStatus && progressPercent) {
        progressContainer.style.display = 'block';
        progressBar.style.width = `${Math.min(100, Math.max(0, percent))}%`;
        progressPercent.textContent = `${Math.round(percent)}%`;
        progressStatus.textContent = statusText;
      }
    }

    function hideProgress() {
      if (progressContainer) {
        progressContainer.style.display = 'none';
      }
    }

    function formatDuration(totalSeconds: number): string {
      const hrs = Math.floor(totalSeconds / 3600);
      const mins = Math.floor((totalSeconds % 3600) / 60);
      const secs = Math.floor(totalSeconds % 60);
      return `${String(hrs).padStart(2, '0')}:${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
    }

    function updateOutput() {
      if (!srtTextarea) return;
      const srt = cuesToSrt(activeCues);
      srtTextarea.value = srt;

      const hasCues = activeCues.length > 0;
      if (btnCopy) btnCopy.disabled = !hasCues;
      if (btnDownload) btnDownload.disabled = !hasCues;

      if (outputStats) {
        let maxMs = 0;
        activeCues.forEach((c) => {
          if (c.endMs > maxMs) maxMs = c.endMs;
        });
        const durationSec = Math.ceil(maxMs / 1000);
        outputStats.textContent = `${activeCues.length} cues | ${formatDuration(durationSec)}`;
      }

      if (inputStats) {
        const charCount = activeCues.reduce((acc, c) => acc + c.text.length, 0);
        inputStats.textContent = `${charCount} characters | ${activeCues.length} cues`;
      }
    }

    function renderCueCards() {
      if (!cuesList) return;
      cuesList.innerHTML = '';

      if (activeCues.length === 0) {
        cuesList.style.display = 'none';
        if (dropzoneInner) dropzoneInner.style.display = 'flex';
        return;
      }

      if (dropzoneInner) dropzoneInner.style.display = 'none';
      cuesList.style.display = 'flex';

      activeCues.forEach((cue, index) => {
        const card = document.createElement('div');
        card.className = 'cue-card';

        const header = document.createElement('div');
        header.className = 'cue-header';
        header.innerHTML = `<span>#${cue.id}</span><span class="cue-time-badge">${formatSrtTimestamp(cue.startMs)} &rarr; ${formatSrtTimestamp(cue.endMs)}</span>`;
        card.appendChild(header);

        // Canvas preview of PGS image
        const canvas = document.createElement('canvas');
        canvas.className = 'cue-preview-canvas';
        canvas.width = cue.width;
        canvas.height = cue.height;
        const ctx = canvas.getContext('2d');
        if (ctx) {
          const imgData = new ImageData(cue.rgbaData, cue.width, cue.height);
          ctx.putImageData(imgData, 0, 0);
        }
        card.appendChild(canvas);

        // Editable textarea for OCR dialogue
        const textarea = document.createElement('textarea');
        textarea.className = 'cue-text-input';
        textarea.value = cue.text;
        textarea.placeholder = 'Enter subtitle dialogue...';
        textarea.spellcheck = false;

        textarea.addEventListener('input', () => {
          activeCues[index].text = textarea.value;
          updateOutput();
        });

        card.appendChild(textarea);
        cuesList.appendChild(card);
      });
    }

    function cleanOcrText(rawText: string): string {
      let t = rawText.trim();
      const preserveLines = preserveMultilineCheckbox ? preserveMultilineCheckbox.checked : true;
      const autocorrect = autocorrectCheckbox ? autocorrectCheckbox.checked : true;

      if (!preserveLines) {
        t = t.replace(/\r?\n+/g, ' ');
      }

      if (autocorrect) {
        // Fix typical OCR confusion: '|' -> 'I'
        t = t.replace(/\|/g, 'I');
        // Fix double spaces
        t = t.replace(/[ \t]+/g, ' ');
      }

      return t;
    }

    async function loadTesseractLibrary(): Promise<any> {
      if ((window as any).Tesseract) {
        return (window as any).Tesseract;
      }
      return new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js';
        script.onload = () => resolve((window as any).Tesseract);
        script.onerror = () => reject(new Error('Unable to load client-side OCR library (Tesseract.js). Please check your internet connection.'));
        document.head.appendChild(script);
      });
    }

    async function runOcrPipeline(cues: DecodedPgsCue[]) {
      isOcrCancelled = false;
      const selectedLang = ocrLangSelect ? ocrLangSelect.value : 'eng';

      updateProgress(10, `Initializing ${selectedLang.toUpperCase()} OCR engine...`);

      let Tesseract: any;
      try {
        Tesseract = await loadTesseractLibrary();
      } catch (err: any) {
        showError(err.message || 'Failed to load OCR library.');
        hideProgress();
        // Fallback: render cues with empty text so timestamps and images are not lost!
        activeCues = cues.map((c) => ({
          id: c.id,
          startMs: c.startMs,
          endMs: c.endMs,
          text: '',
          width: c.width,
          height: c.height,
          rgbaData: c.rgbaData,
        }));
        renderCueCards();
        updateOutput();
        return;
      }

      updateProgress(20, 'Loading OCR language models...');

      try {
        tesseractWorker = await Tesseract.createWorker(selectedLang);
      } catch (workerErr: any) {
        showError('Could not start OCR Web Worker: ' + (workerErr.message || 'Unknown error'));
        hideProgress();
        activeCues = cues.map((c) => ({
          id: c.id,
          startMs: c.startMs,
          endMs: c.endMs,
          text: '',
          width: c.width,
          height: c.height,
          rgbaData: c.rgbaData,
        }));
        renderCueCards();
        updateOutput();
        return;
      }

      activeCues = cues.map((c) => ({
        id: c.id,
        startMs: c.startMs,
        endMs: c.endMs,
        text: '',
        width: c.width,
        height: c.height,
        rgbaData: c.rgbaData,
      }));

      renderCueCards();

      const total = cues.length;
      for (let i = 0; i < total; i++) {
        if (isOcrCancelled) {
          updateProgress(100, 'OCR cancelled by user.');
          break;
        }

        const cue = cues[i];
        const progressPct = 25 + Math.round(((i + 1) / total) * 70);
        updateProgress(progressPct, `Recognizing subtitle cue ${i + 1} of ${total}...`);

        // Render to offscreen canvas with high contrast binarization for OCR
        const ocrCanvas = document.createElement('canvas');
        ocrCanvas.width = cue.width + 16;
        ocrCanvas.height = cue.height + 16;
        const ocrCtx = ocrCanvas.getContext('2d');
        if (ocrCtx) {
          // White background
          ocrCtx.fillStyle = '#ffffff';
          ocrCtx.fillRect(0, 0, ocrCanvas.width, ocrCanvas.height);

          // Draw pixels inverted: dark text on white background for best OCR recognition
          const imgData = ocrCtx.createImageData(cue.width, cue.height);
          for (let p = 0; p < cue.rgbaData.length; p += 4) {
            const alpha = cue.rgbaData[p + 3];
            if (alpha > 40) {
              // Dark pixel
              imgData.data[p] = 0;
              imgData.data[p + 1] = 0;
              imgData.data[p + 2] = 0;
              imgData.data[p + 3] = 255;
            } else {
              // Transparent becomes white
              imgData.data[p] = 255;
              imgData.data[p + 1] = 255;
              imgData.data[p + 2] = 255;
              imgData.data[p + 3] = 255;
            }
          }
          ocrCtx.putImageData(imgData, 8, 8);
        }

        try {
          const ret = await tesseractWorker.recognize(ocrCanvas);
          const recognizedText = cleanOcrText(ret.data?.text || '');
          activeCues[i].text = recognizedText;
          renderCueCards();
          updateOutput();
        } catch (recErr) {
          console.warn(`OCR error on cue ${i + 1}:`, recErr);
        }
      }

      updateProgress(100, 'OCR conversion complete!');
      setTimeout(() => hideProgress(), 1500);

      if (tesseractWorker) {
        try {
          await tesseractWorker.terminate();
        } catch (_) {}
        tesseractWorker = null;
      }
    }

    async function handleFileBytes(bytes: Uint8Array, fileName: string) {
      clearError();
      currentFileName = fileName.replace(/\.[^/.]+$/, '') + '.srt';

      updateProgress(5, 'Parsing PGS binary display sets...');

      try {
        const result = parseSup(bytes);
        if (!result.success || result.cues.length === 0) {
          showError(result.error || 'Failed to parse SUP file.');
          hideProgress();
          return;
        }

        await runOcrPipeline(result.cues);
      } catch (err: any) {
        showError('Unexpected error reading PGS SUP data: ' + (err.message || 'Corrupted file'));
        hideProgress();
      }
    }

    // Load Sample SUP (in-memory synthetic PGS file)
    if (btnLoadSample) {
      btnLoadSample.addEventListener('click', async () => {
        clearError();
        const sampleBytes = generateSampleSupFile();
        await handleFileBytes(sampleBytes, 'sample-bluray.srt');
      });
    }

    // Reset button
    if (btnReset) {
      btnReset.addEventListener('click', () => {
        isOcrCancelled = true;
        if (tesseractWorker) {
          try {
            tesseractWorker.terminate();
          } catch (_) {}
          tesseractWorker = null;
        }
        activeCues = [];
        hideProgress();
        clearError();
        renderCueCards();
        updateOutput();
        if (fileUpload) fileUpload.value = '';
      });
    }

    // Cancel OCR
    if (btnCancelOcr) {
      btnCancelOcr.addEventListener('click', () => {
        isOcrCancelled = true;
        hideProgress();
      });
    }

    // File upload change
    if (fileUpload) {
      fileUpload.addEventListener('change', (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = async (event) => {
          const buffer = event.target?.result as ArrayBuffer;
          if (buffer) {
            await handleFileBytes(new Uint8Array(buffer), file.name);
          }
        };
        reader.readAsArrayBuffer(file);
      });
    }

    // Drag and drop handlers
    const dropzone = document.getElementById('sup-dropzone');
    if (dropzone && dropzoneInner) {
      ['dragenter', 'dragover'].forEach((eventName) => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzoneInner.classList.add('dragover');
        });
      });

      ['dragleave', 'drop'].forEach((eventName) => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzoneInner.classList.remove('dragover');
        });
      });

      dropzone.addEventListener('drop', (e) => {
        const file = e.dataTransfer?.files?.[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = async (event) => {
          const buffer = event.target?.result as ArrayBuffer;
          if (buffer) {
            await handleFileBytes(new Uint8Array(buffer), file.name);
          }
        };
        reader.readAsArrayBuffer(file);
      });
    }

    // Copy SRT
    if (btnCopy && srtTextarea) {
      btnCopy.addEventListener('click', async () => {
        const text = srtTextarea.value;
        if (!text) return;

        try {
          await navigator.clipboard.writeText(text);
          const originalText = copyBtnText ? copyBtnText.textContent : 'Copy';
          if (copyBtnText) copyBtnText.textContent = 'Copied!';
          setTimeout(() => {
            if (copyBtnText) copyBtnText.textContent = originalText;
          }, 2000);
        } catch (_) {
          srtTextarea.select();
          document.execCommand('copy');
        }
      });
    }

    // Download SRT
    if (btnDownload && srtTextarea) {
      btnDownload.addEventListener('click', () => {
        const text = srtTextarea.value;
        if (!text) return;

        const blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = currentFileName || 'subtitles.srt';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });
    }

    // Synchronize edits made directly in srtTextarea
    if (srtTextarea) {
      srtTextarea.addEventListener('input', () => {
        if (outputStats) {
          const matches = srtTextarea.value.match(/\d{2}:\d{2}:\d{2},\d{3} --> \d{2}:\d{2}:\d{2},\d{3}/g) || [];
          outputStats.textContent = `${matches.length} cues`;
        }
      });
    }
  })();
</script>
