---
import { type Locale } from '@/i18n/config';
import { getRoutePath } from '@/i18n/routes';
import { getTxtToSrtGuideContent } from '@/i18n/txtToSrtGuide';
import { getToolsContent } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const guide = getTxtToSrtGuideContent(locale);
const tools = getToolsContent(locale);

const srtToTextUrl = getRoutePath('srt-to-text', locale);
const srtToVttUrl = getRoutePath('srt-to-vtt', locale);
const vttToSrtUrl = getRoutePath('vtt-to-srt', locale);
---

<section class="guide-container">
  <!-- Article Prose Content -->
  <div class="article-prose guide-prose">
    <!-- Introduction -->
    <div class="guide-intro-card">
      <h2>{guide.introTitle}</h2>
      <p class="guide-lead-text">{guide.introSubtitle}</p>
      {guide.introText.map((p) => (
        <p>{p}</p>
      ))}
    </div>

    <hr class="guide-divider" />

    <!-- What Is a TXT to SRT Converter? -->
    <section>
      <h2>{guide.whatIsTitle}</h2>
      {guide.whatIsText.map((p) => (
        <p>{p}</p>
      ))}

      <!-- Feature Comparison Table -->
      <div class="guide-table-wrapper">
        <table class="guide-table">
          <thead>
            <tr>
              <th>Feature</th>
              <th>Plain Text (.TXT)</th>
              <th>SubRip Subtitles (.SRT)</th>
            </tr>
          </thead>
          <tbody>
            {guide.whatIsComparison.map((row) => (
              <tr>
                <td><strong>{row.feature}</strong></td>
                <td>{row.txt}</td>
                <td><span class="badge-inline">{row.srt}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <hr class="guide-divider" />

    <!-- How to Convert TXT to SRT Online -->
    <section>
      <h2>{guide.howToTitle}</h2>
      <p>{guide.howToSubtitle}</p>
      <div class="guide-steps-list">
        {guide.howToSteps.map((s) => (
          <div class="guide-step-item">
            <div class="guide-step-badge">{s.step}</div>
            <div class="guide-step-body">
              <h3>{s.title}</h3>
              <p>{s.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <hr class="guide-divider" />

    <!-- How Does TXT to SRT Conversion Work? -->
    <section>
      <h2>{guide.howItWorksTitle}</h2>
      {guide.howItWorksText.map((p) => (
        <p>{p}</p>
      ))}
      <div class="guide-cards-grid">
        {guide.howItWorksBullets.map((b) => (
          <div class="guide-feature-box">
            <h3>{b.title}</h3>
            <p>{b.description}</p>
          </div>
        ))}
      </div>
    </section>

    <hr class="guide-divider" />

    <!-- TXT to SRT Conversion Example: Before & After -->
    <section>
      <h2>{guide.exampleTitle}</h2>
      <p>{guide.exampleIntro}</p>

      <div class="code-compare-grid">
        <div class="code-box">
          <div class="code-box-header">
            <span class="code-badge txt-badge">Raw Input (.TXT)</span>
          </div>
          <pre class="code-content"><code>{guide.exampleTxtInput}</code></pre>
        </div>

        <div class="code-box">
          <div class="code-box-header">
            <span class="code-badge srt-badge">Formatted Output (.SRT)</span>
          </div>
          <pre class="code-content"><code>{guide.exampleSrtOutput}</code></pre>
        </div>
      </div>

      <div class="guide-callout info">
        <p><strong>Analysis:</strong> {guide.exampleExplanation}</p>
      </div>
    </section>

    <hr class="guide-divider" />

    <!-- Understanding the SRT File Format -->
    <section>
      <h2>{guide.srtFormatTitle}</h2>
      <p>{guide.srtFormatIntro}</p>

      <div class="guide-components-grid">
        {guide.srtFormatElements.map((el) => (
          <div class="guide-element-card">
            <div class="element-num">{el.num}</div>
            <div class="element-content">
              <h3>{el.name}</h3>
              <p>{el.detail}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="timecode-formula-box">
        <div class="formula-label">Standard SRT Timecode Syntax:</div>
        <div class="formula-code"><code>{guide.srtTimestampFormula}</code></div>
      </div>
      <p class="formula-note">{guide.srtTimestampExplanation}</p>
    </section>

    <hr class="guide-divider" />

    <!-- When Should You Convert TXT to SRT? -->
    <section>
      <h2>{guide.useCasesTitle}</h2>
      <p>{guide.useCasesSubtitle}</p>
      <div class="guide-usecases-grid">
        {guide.useCases.map((uc) => (
          <div class="usecase-card">
            <h3>{uc.title}</h3>
            <p>{uc.description}</p>
          </div>
        ))}
      </div>
    </section>

    <hr class="guide-divider" />

    <!-- TXT to SRT Without Installing Software -->
    <section>
      <h2>{guide.noSoftwareTitle}</h2>
      {guide.noSoftwareText.map((p) => (
        <p>{p}</p>
      ))}
      <div class="guide-benefits-grid">
        {guide.noSoftwareBenefits.map((b) => (
          <div class="benefit-card">
            <div class="benefit-icon">✓</div>
            <div class="benefit-content">
              <h3>{b.title}</h3>
              <p>{b.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <hr class="guide-divider" />

    <!-- How to Convert TXT to SRT on Mac -->
    <section>
      <h2>{guide.macGuideTitle}</h2>
      {guide.macGuideText.map((p) => (
        <p>{p}</p>
      ))}
      <div class="mac-steps-box">
        {guide.macSteps.map((s) => (
          <div class="mac-step-row">
            <span class="mac-badge">Step {s.step}</span>
            <div>
              <h3>{s.title}</h3>
              <p>{s.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <hr class="guide-divider" />

    <!-- Common Problems & Troubleshooting -->
    <section>
      <h2>{guide.troubleshootingTitle}</h2>
      <p>{guide.troubleshootingSubtitle}</p>
      <div class="trouble-list">
        {guide.problems.map((prob) => (
          <div class="trouble-card">
            <h3>⚠️ {prob.issue}</h3>
            <p class="trouble-cause"><strong>Cause:</strong> {prob.cause}</p>
            <p class="trouble-solution"><strong>Fix:</strong> {prob.solution}</p>
          </div>
        ))}
      </div>
    </section>

    <hr class="guide-divider" />

    <!-- Pro Tips for High-Quality SRT Subtitles -->
    <section>
      <h2>{guide.tipsTitle}</h2>
      <p>{guide.tipsSubtitle}</p>
      <div class="tips-grid">
        {guide.tips.map((t) => (
          <div class="tip-card">
            <h3>{t.title}</h3>
            <p class="tip-rule"><strong>Standard Rule:</strong> {t.rule}</p>
            <p class="tip-why"><strong>Why It Matters:</strong> {t.why}</p>
          </div>
        ))}
      </div>
    </section>

    <hr class="guide-divider" />

    <!-- Comparison Table: Automated vs Manual -->
    <section>
      <h2>{guide.comparisonTitle}</h2>
      <p>{guide.comparisonSubtitle}</p>
      <div class="guide-table-wrapper">
        <table class="guide-table comparison">
          <thead>
            <tr>
              <th>Workflow Factor</th>
              <th>Online TXT to SRT Converter</th>
              <th>Manual SRT Writing</th>
            </tr>
          </thead>
          <tbody>
            {guide.comparisonTable.map((row) => (
              <tr>
                <td><strong>{row.factor}</strong></td>
                <td class="col-highlight">{row.converter}</td>
                <td>{row.manual}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="guide-callout success">
        <p><strong>Verdict:</strong> {guide.comparisonVerdict}</p>
      </div>
    </section>

    <hr class="guide-divider" />

    <!-- Conclusion & Internal Tool Links -->
    <section class="guide-conclusion-section">
      <h2>{guide.conclusionTitle}</h2>
      {guide.conclusionText.map((p) => (
        <p>{p}</p>
      ))}

      <!-- Internal Tool CTAs -->
      <div class="related-tools-pills">
        <a href={srtToTextUrl} class="tool-pill">
          <span class="tool-pill-title">{tools.srtToText.name}</span>
          <span class="tool-pill-action">Extract text from SRT &rarr;</span>
        </a>
        <a href={srtToVttUrl} class="tool-pill">
          <span class="tool-pill-title">{tools.srtToVtt.name}</span>
          <span class="tool-pill-action">Convert SRT to WebVTT &rarr;</span>
        </a>
        <a href={vttToSrtUrl} class="tool-pill">
          <span class="tool-pill-title">{tools.vttToSrt.name}</span>
          <span class="tool-pill-action">Convert WebVTT to SubRip &rarr;</span>
        </a>
      </div>
    </section>
  </div>
</section>

<style>
  .guide-container {
    max-width: 56rem;
    margin: 3.5rem auto 2rem auto;
    padding: 0 0.5rem;
  }

  .guide-prose {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-primary);
  }

  .guide-intro-card {
    background: linear-gradient(135deg, var(--bg-secondary) 0%, var(--bg-card) 100%);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    box-shadow: var(--shadow-sm);
    margin-bottom: 2rem;
  }

  .guide-lead-text {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--accent-primary);
    margin-bottom: 1rem !important;
  }

  .guide-divider {
    margin: 3rem 0;
    border: none;
    border-top: 1px solid var(--border-color);
  }

  .guide-table-wrapper {
    overflow-x: auto;
    margin: 1.5rem 0;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
  }

  .guide-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    margin: 0 !important;
  }

  .guide-table th {
    background-color: var(--bg-secondary);
    color: var(--text-primary);
    font-weight: 700;
    padding: 0.875rem 1rem;
    border-bottom: 2px solid var(--border-color);
    text-align: left;
  }

  .guide-table td {
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--border-color);
    color: var(--text-secondary);
  }

  .guide-table tr:last-child td {
    border-bottom: none;
  }

  .guide-table td.col-highlight {
    color: var(--text-primary);
    font-weight: 600;
    background-color: var(--accent-light);
  }

  .badge-inline {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    background-color: var(--accent-light);
    color: var(--accent-primary);
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  /* Steps List */
  .guide-steps-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 1.5rem 0;
  }

  .guide-step-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 1.25rem;
    box-shadow: var(--shadow-sm);
  }

  .guide-step-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    background-color: var(--accent-primary);
    color: #ffffff;
    font-weight: 800;
    font-size: 1.125rem;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .guide-step-body h3 {
    margin: 0 0 0.375rem 0;
    font-size: 1.0625rem;
  }

  .guide-step-body p {
    margin: 0 !important;
  }

  /* Grid Cards */
  .guide-cards-grid,
  .guide-usecases-grid,
  .tips-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin: 1.5rem 0;
  }

  @media (min-width: 680px) {
    .guide-cards-grid,
    .guide-usecases-grid,
    .tips-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }

  .guide-feature-box,
  .usecase-card,
  .tip-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 1.25rem;
    box-shadow: var(--shadow-sm);
  }

  .guide-feature-box h3,
  .usecase-card h3,
  .tip-card h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1rem;
    color: var(--text-primary);
  }

  .tip-rule {
    color: var(--accent-primary) !important;
    font-size: 0.9375rem;
    margin-bottom: 0.375rem !important;
  }

  .tip-why {
    font-size: 0.875rem;
    margin-bottom: 0 !important;
  }

  /* Code Comparison */
  .code-compare-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin: 1.5rem 0;
  }

  @media (min-width: 768px) {
    .code-compare-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .code-box {
    background-color: var(--code-bg);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .code-box-header {
    background-color: rgba(255, 255, 255, 0.05);
    padding: 0.5rem 0.875rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .code-badge {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .txt-badge {
    background-color: #475569;
    color: #f8fafc;
  }

  .srt-badge {
    background-color: #2563eb;
    color: #ffffff;
  }

  .code-content {
    padding: 1rem;
    color: var(--code-text);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.5;
    white-space: pre-wrap;
    word-break: break-word;
    margin: 0;
  }

  /* Callouts */
  .guide-callout {
    border-left: 4px solid var(--accent-primary);
    background-color: var(--bg-secondary);
    padding: 1rem 1.25rem;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    margin: 1.25rem 0;
  }

  .guide-callout.info {
    border-left-color: var(--accent-primary);
  }

  .guide-callout.success {
    border-left-color: var(--success);
    background-color: var(--success-bg);
  }

  .guide-callout p {
    margin: 0 !important;
  }

  /* Components Grid */
  .guide-components-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin: 1.5rem 0;
  }

  @media (min-width: 640px) {
    .guide-components-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .guide-element-card {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 1.25rem;
    box-shadow: var(--shadow-sm);
  }

  .element-num {
    width: 1.875rem;
    height: 1.875rem;
    background-color: var(--accent-light);
    color: var(--accent-text);
    font-weight: 800;
    font-size: 0.9375rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .element-content h3 {
    margin: 0 0 0.375rem 0;
    font-size: 0.9375rem;
  }

  .element-content p {
    margin: 0 !important;
    font-size: 0.875rem;
  }

  .timecode-formula-box {
    background-color: var(--bg-secondary);
    border: 1px dashed var(--accent-primary);
    border-radius: var(--radius-sm);
    padding: 1rem;
    text-align: center;
    margin: 1.5rem 0 0.5rem 0;
  }

  .formula-label {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }

  .formula-code {
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--accent-primary);
  }

  .formula-note {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  /* Benefits */
  .guide-benefits-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin: 1.5rem 0;
  }

  @media (min-width: 640px) {
    .guide-benefits-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .benefit-card {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 1.25rem;
  }

  .benefit-icon {
    width: 1.5rem;
    height: 1.5rem;
    background-color: var(--success-bg);
    color: var(--success);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.875rem;
    flex-shrink: 0;
  }

  .benefit-content h3 {
    margin: 0 0 0.25rem 0;
    font-size: 0.9375rem;
  }

  .benefit-content p {
    margin: 0 !important;
    font-size: 0.875rem;
  }

  /* Mac Guide */
  .mac-steps-box {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 1.5rem 0;
  }

  .mac-step-row {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 1.25rem;
  }

  .mac-badge {
    background-color: var(--bg-tertiary);
    color: var(--text-primary);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  .mac-step-row h3 {
    margin: 0 0 0.25rem 0;
    font-size: 1rem;
  }

  .mac-step-row p {
    margin: 0 !important;
    font-size: 0.875rem;
  }

  /* Troubleshooting */
  .trouble-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 1.5rem 0;
  }

  .trouble-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-left: 4px solid var(--warning);
    border-radius: var(--radius-sm);
    padding: 1.25rem;
    box-shadow: var(--shadow-sm);
  }

  .trouble-card h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1rem;
    color: var(--text-primary);
  }

  .trouble-cause {
    color: var(--text-muted) !important;
    font-size: 0.875rem;
    margin-bottom: 0.375rem !important;
  }

  .trouble-solution {
    color: var(--text-secondary) !important;
    font-size: 0.875rem;
    margin-bottom: 0 !important;
  }

  /* Related Tools Pills */
  .related-tools-pills {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 2rem;
  }

  @media (min-width: 640px) {
    .related-tools-pills {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .tool-pill {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.5rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    padding: 1rem 1.25rem;
    text-decoration: none;
    transition: all 0.15s ease;
    box-shadow: var(--shadow-sm);
  }

  .tool-pill:hover {
    border-color: var(--accent-primary);
    transform: translateY(-2px);
    text-decoration: none;
    box-shadow: var(--shadow-md);
  }

  .tool-pill-title {
    font-weight: 700;
    color: var(--text-primary);
    font-size: 0.9375rem;
  }

  .tool-pill-action {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent-primary);
  }
</style>
