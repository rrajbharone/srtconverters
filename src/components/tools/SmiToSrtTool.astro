---
import type { Locale } from '@/i18n/config';
import { getToolsContent, getUiStrings } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUiStrings(locale);
const tools = getToolsContent(locale);
const tool = tools.smiToSrt;
---

<div class="tool-workspace" id="smi-to-srt-app">
  <!-- Privacy Guarantee Alert -->
  <div class="privacy-banner">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
      <path d="M9 12l2 2 4-4"></path>
    </svg>
    <span><strong>{ui.privacyNotice.title}:</strong> {ui.privacyNotice.description}</span>
  </div>

  <div class="tool-grid">
    <!-- Left Pane: SMI Input -->
    <div class="tool-pane">
      <div class="pane-header">
        <span class="pane-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
          SMI / SAMI Input (.smi)
        </span>
        <div class="pane-actions">
          <button type="button" class="btn btn-outline btn-sm" id="btn-load-smi-sample">
            {ui.common.loadSample}
          </button>
          <button type="button" class="btn btn-outline btn-sm" id="btn-clear-smi-input">
            {ui.common.clear}
          </button>
        </div>
      </div>

      <div class="dropzone-container" id="smi-dropzone">
        <textarea
          id="smi-input"
          class="tool-textarea"
          placeholder="<SAMI>&#10;<HEAD><TITLE>Sample</TITLE></HEAD>&#10;<BODY>&#10;<SYNC Start=1200><P Class=KRCC>Paste SAMI / SMI subtitles here...&#10;<SYNC Start=4500><P Class=KRCC>&nbsp;&#10;</BODY>&#10;</SAMI>"
          spellcheck="false"
        ></textarea>
        
        <div class="dropzone-overlay">
          <span>{ui.common.dragAndDrop}</span>
          <label for="smi-file-upload" class="btn btn-secondary btn-sm" style="margin: 0; cursor: pointer;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="17 8 12 3 7 8"></polyline>
              <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
            <span>{ui.common.browseFiles}</span>
          </label>
          <input type="file" id="smi-file-upload" class="file-input-hidden" accept=".smi,.sami,.txt,text/plain" />
        </div>
      </div>

      <div class="pane-footer-counts">
        <span id="smi-input-stats">0 lines | 0 characters</span>
      </div>
    </div>

    <!-- Right Pane: SRT Output -->
    <div class="tool-pane">
      <div class="pane-header">
        <span class="pane-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="4 17 10 11 4 5"></polyline>
            <line x1="12" y1="19" x2="20" y2="19"></line>
          </svg>
          SubRip SRT Output (.srt)
        </span>
        <div class="pane-actions">
          <button type="button" class="btn btn-outline btn-sm" id="btn-copy-srt" disabled>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="copy-srt-btn-text">{ui.common.copy}</span>
          </button>
          <button type="button" class="btn btn-primary btn-sm" id="btn-download-srt" disabled>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>{ui.common.download}</span>
          </button>
        </div>
      </div>

      <textarea
        id="srt-output"
        class="tool-textarea"
        readonly
        placeholder="1&#10;00:00:01,200 --> 00:00:04,500&#10;Converted SubRip SRT subtitles will appear here...&#10;&#10;Ready for Premiere Pro, DaVinci Resolve, VLC & Plex!"
      ></textarea>

      <div class="pane-footer-counts">
        <span id="smi-output-stats">0 cues | 0 characters</span>
      </div>
    </div>
  </div>

  <!-- Settings Panel -->
  <div class="settings-panel">
    <div class="settings-panel-title">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="3"></circle>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
      </svg>
      {tool.settingsLabels.timingMode || ui.common.settings}
    </div>

    <div class="settings-grid">
      <!-- Language Track Selector -->
      <div class="setting-group">
        <label class="setting-label" for="select-language-class">
          {tool.settingsLabels.fixedDuration}
        </label>
        <select id="select-language-class" class="setting-select">
          <option value="all">All Language Tracks</option>
          <option value="KRCC">Korean (.KRCC)</option>
          <option value="ENCC">English (.ENCC)</option>
        </select>
        <span class="setting-hint">{tool.settingsLabels.cpsDuration}</span>
      </div>

      <!-- File Encoding Selector -->
      <div class="setting-group">
        <label class="setting-label" for="select-file-encoding">
          {tool.settingsLabels.startTime}
        </label>
        <select id="select-file-encoding" class="setting-select">
          <option value="utf-8">UTF-8 (Default / Universal)</option>
          <option value="euc-kr">EUC-KR / CP949 (Korean Legacy)</option>
          <option value="windows-1252">Windows-1252 (Western ANSI)</option>
        </select>
        <span class="setting-hint">{tool.settingsLabels.startTimeHint}</span>
      </div>

      <!-- Checkboxes -->
      <div class="setting-group" style="justify-content: center;">
        <label class="setting-checkbox-item" title={tool.settingsLabels.cpsHint}>
          <input type="checkbox" id="check-clean-html" checked />
          <span>{tool.settingsLabels.cpsLabel}</span>
        </label>
      </div>

      <div class="setting-group" style="justify-content: center;">
        <label class="setting-checkbox-item">
          <input type="checkbox" id="check-normalize-whitespace" checked />
          <span>Normalize Whitespace</span>
        </label>
      </div>
    </div>
  </div>
</div>

<script>
  import { convertSmiToSrt, SAMPLE_SMI } from '@/lib/smi-converters';

  function initSmiToSrt() {
    const smiInput = document.getElementById('smi-input') as HTMLTextAreaElement | null;
    const srtOutput = document.getElementById('srt-output') as HTMLTextAreaElement | null;
    const btnSample = document.getElementById('btn-load-smi-sample') as HTMLButtonElement | null;
    const btnClear = document.getElementById('btn-clear-smi-input') as HTMLButtonElement | null;
    const btnCopy = document.getElementById('btn-copy-srt') as HTMLButtonElement | null;
    const btnDownload = document.getElementById('btn-download-srt') as HTMLButtonElement | null;
    const copyBtnText = document.getElementById('copy-srt-btn-text') as HTMLElement | null;
    const fileUpload = document.getElementById('smi-file-upload') as HTMLInputElement | null;
    const dropzone = document.getElementById('smi-dropzone') as HTMLElement | null;
    const inputStats = document.getElementById('smi-input-stats') as HTMLElement | null;
    const outputStats = document.getElementById('smi-output-stats') as HTMLElement | null;

    const selectLanguage = document.getElementById('select-language-class') as HTMLSelectElement | null;
    const selectEncoding = document.getElementById('select-file-encoding') as HTMLSelectElement | null;
    const checkCleanHtml = document.getElementById('check-clean-html') as HTMLInputElement | null;
    const checkNormalizeWhitespace = document.getElementById('check-normalize-whitespace') as HTMLInputElement | null;

    let originalFilename = 'subtitles';
    let lastUploadedFile: File | null = null;

    function doConversion() {
      if (!smiInput || !srtOutput) return;
      const rawText = smiInput.value;

      const rawChars = rawText.length;
      const rawLines = rawText ? rawText.split('\n').length : 0;
      if (inputStats) {
        inputStats.textContent = `${rawLines} lines | ${rawChars} characters`;
      }

      if (!rawText.trim()) {
        srtOutput.value = '';
        if (outputStats) outputStats.textContent = '0 cues | 0 characters';
        if (btnCopy) btnCopy.disabled = true;
        if (btnDownload) btnDownload.disabled = true;
        return;
      }

      const selectedClass = selectLanguage?.value || 'all';

      const result = convertSmiToSrt(rawText, {
        cleanHtmlTags: checkCleanHtml?.checked ?? true,
        normalizeWhitespace: checkNormalizeWhitespace?.checked ?? true,
        selectedLanguageClass: selectedClass,
      });

      if (selectLanguage && result.detectedClasses && result.detectedClasses.length > 0) {
        const currentVal = selectLanguage.value;
        const currentOptions = Array.from(selectLanguage.options).map((o) => o.value);
        result.detectedClasses.forEach((cls) => {
          if (!currentOptions.includes(cls)) {
            const opt = document.createElement('option');
            opt.value = cls;
            opt.textContent = `Class: ${cls}`;
            selectLanguage.appendChild(opt);
          }
        });
        selectLanguage.value = currentVal;
      }

      srtOutput.value = result.srt;

      if (outputStats) {
        outputStats.textContent = `${result.cueCount} cues | ${result.srt.length} characters`;
      }

      const hasContent = Boolean(result.srt && result.srt.trim().length > 0);
      if (btnCopy) btnCopy.disabled = !hasContent;
      if (btnDownload) btnDownload.disabled = !hasContent;
    }

    smiInput?.addEventListener('input', doConversion);
    selectLanguage?.addEventListener('change', doConversion);
    checkCleanHtml?.addEventListener('change', doConversion);
    checkNormalizeWhitespace?.addEventListener('change', doConversion);

    selectEncoding?.addEventListener('change', () => {
      if (lastUploadedFile) {
        readFileWithEncoding(lastUploadedFile);
      }
    });

    btnSample?.addEventListener('click', () => {
      if (smiInput) {
        smiInput.value = SAMPLE_SMI;
        originalFilename = 'sample_korean_drama';
        lastUploadedFile = null;
        doConversion();
      }
    });

    btnClear?.addEventListener('click', () => {
      if (smiInput) {
        smiInput.value = '';
        originalFilename = 'subtitles';
        lastUploadedFile = null;
        doConversion();
      }
    });

    function readFileWithEncoding(file: File) {
      const encoding = selectEncoding?.value || 'utf-8';
      const reader = new FileReader();
      reader.onload = (event) => {
        if (smiInput && typeof event.target?.result === 'string') {
          smiInput.value = event.target.result;
          doConversion();
        }
      };
      reader.readAsText(file, encoding);
    }

    fileUpload?.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.files && target.files[0]) {
        const file = target.files[0];
        lastUploadedFile = file;
        originalFilename = file.name.replace(/\.[^/.]+$/, '');
        readFileWithEncoding(file);
      }
    });

    if (dropzone) {
      ['dragenter', 'dragover'].forEach((eventName) => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.add('dragover');
        });
      });

      ['dragleave', 'drop'].forEach((eventName) => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.remove('dragover');
        });
      });

      dropzone.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        if (dt && dt.files && dt.files[0]) {
          const file = dt.files[0];
          lastUploadedFile = file;
          originalFilename = file.name.replace(/\.[^/.]+$/, '');
          readFileWithEncoding(file);
        }
      });
    }

    btnCopy?.addEventListener('click', async () => {
      if (!srtOutput || !srtOutput.value) return;
      try {
        await navigator.clipboard.writeText(srtOutput.value);
        if (copyBtnText) {
          const originalText = copyBtnText.textContent;
          copyBtnText.textContent = 'Copied!';
          setTimeout(() => {
            if (copyBtnText) copyBtnText.textContent = originalText;
          }, 2000);
        }
      } catch (err) {
        console.error('Failed to copy: ', err);
      }
    });

    btnDownload?.addEventListener('click', () => {
      if (!srtOutput || !srtOutput.value) return;
      const blob = new Blob([srtOutput.value], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${originalFilename}.srt`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });

    if (smiInput && !smiInput.value.trim()) {
      smiInput.value = SAMPLE_SMI;
      doConversion();
    }
  }

  initSmiToSrt();
  document.addEventListener('astro:page-load', initSmiToSrt);
</script>

<style>
  .tool-textarea {
    width: 100%;
    box-sizing: border-box;
  }

  .pane-footer-counts {
    display: flex;
    justify-content: flex-end;
    font-size: 0.75rem;
    color: var(--text-muted);
    padding: 0.4rem 0.5rem 0;
  }

  .setting-checkbox-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    font-size: 0.875rem;
    color: var(--text-primary);
    user-select: none;
  }

  .setting-checkbox-item input[type="checkbox"] {
    cursor: pointer;
    width: 1rem;
    height: 1rem;
    accent-color: var(--accent-primary);
    flex-shrink: 0;
  }

  .setting-select {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    text-overflow: ellipsis;
    white-space: nowrap;
    overflow: hidden;
    box-sizing: border-box;
  }

  @media (max-width: 768px) {
    .tool-textarea {
      height: 180px !important;
      min-height: 160px;
      padding: 0.75rem;
      font-size: 0.8125rem;
      line-height: 1.5;
    }

    .dropzone-container {
      min-height: unset;
    }

    .dropzone-overlay {
      padding: 0.45rem 0.75rem;
      font-size: 0.75rem;
    }

    .pane-header {
      padding: 0.5rem 0.75rem;
    }

    .pane-footer-counts {
      padding: 0.25rem 0.5rem 0;
      font-size: 0.6875rem;
    }

    .setting-select {
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
    }
  }
</style>
