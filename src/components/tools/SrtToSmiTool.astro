---
import type { Locale } from '@/i18n/config';
import { getToolsContent, getUiStrings } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUiStrings(locale);
const tools = getToolsContent(locale);
const tool = tools.srtToSmi;
---

<div class="tool-workspace" id="srt-to-smi-app">
  <!-- Privacy Guarantee Alert -->
  <div class="privacy-banner">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
      <path d="M9 12l2 2 4-4"></path>
    </svg>
    <span><strong>{ui.privacyNotice.title}:</strong> {ui.privacyNotice.description}</span>
  </div>

  <div class="tool-grid">
    <!-- Left Pane: SRT Input -->
    <div class="tool-pane">
      <div class="pane-header">
        <span class="pane-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
          SubRip SRT Input (.srt)
        </span>
        <div class="pane-actions">
          <button type="button" class="btn btn-outline btn-sm" id="btn-load-srt-sample">
            {ui.common.loadSample}
          </button>
          <button type="button" class="btn btn-outline btn-sm" id="btn-clear-srt-input">
            {ui.common.clear}
          </button>
        </div>
      </div>

      <div class="dropzone-container" id="srt-dropzone">
        <textarea
          id="srt-input"
          class="tool-textarea"
          placeholder="1&#10;00:00:01,000 --> 00:00:04,500&#10;Paste your SubRip (.srt) subtitles here...&#10;&#10;Or drop an .srt file directly onto this area!"
          spellcheck="false"
        ></textarea>
        
        <div class="dropzone-overlay">
          <span>{ui.common.dragAndDrop}</span>
          <label for="srt-file-upload" class="btn btn-secondary btn-sm" style="margin: 0; cursor: pointer;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="17 8 12 3 7 8"></polyline>
              <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
            <span>{ui.common.browseFiles}</span>
          </label>
          <input type="file" id="srt-file-upload" class="file-input-hidden" accept=".srt,.txt,text/plain" />
        </div>
      </div>

      <div class="pane-footer-counts">
        <span id="srt-input-stats">0 lines | 0 characters</span>
      </div>
    </div>

    <!-- Right Pane: SMI Output -->
    <div class="tool-pane">
      <div class="pane-header">
        <span class="pane-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="4 17 10 11 4 5"></polyline>
            <line x1="12" y1="19" x2="20" y2="19"></line>
          </svg>
          Microsoft SAMI Output (.smi)
        </span>
        <div class="pane-actions">
          <button type="button" class="btn btn-outline btn-sm" id="btn-copy-smi" disabled>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="copy-smi-btn-text">{ui.common.copy}</span>
          </button>
          <button type="button" class="btn btn-primary btn-sm" id="btn-download-smi" disabled>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>{ui.common.download}</span>
          </button>
        </div>
      </div>

      <textarea
        id="smi-output"
        class="tool-textarea"
        readonly
        placeholder="<SAMI>&#10;<HEAD>&#10;<TITLE>Converted Subtitles</TITLE>&#10;...&#10;<BODY>&#10;<SYNC Start=1000><P Class=KRCC>Converted Microsoft SAMI captions will appear here...&#10;<SYNC Start=4500><P Class=KRCC>&nbsp;&#10;</BODY>&#10;</SAMI>"
      ></textarea>

      <div class="pane-footer-counts">
        <span id="smi-output-stats">0 cues | 0 characters</span>
      </div>
    </div>
  </div>

  <!-- Settings Panel -->
  <div class="settings-panel">
    <div class="settings-panel-title">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="3"></circle>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
      </svg>
      {tool.settingsLabels.timingMode || ui.common.settings}
    </div>

    <div class="settings-grid">
      <!-- Language Track Class Selector -->
      <div class="setting-group">
        <label class="setting-label" for="select-sami-class">
          {tool.settingsLabels.fixedDuration}
        </label>
        <select id="select-sami-class" class="setting-select">
          <option value="KRCC">Korean (.KRCC)</option>
          <option value="ENCC">English (.ENCC)</option>
          <option value="FRCC">French (.FRCC)</option>
          <option value="ESCC">Spanish (.ESCC)</option>
          <option value="DECC">German (.DECC)</option>
          <option value="ITCC">Italian (.ITCC)</option>
        </select>
        <span class="setting-hint">{tool.settingsLabels.cpsDuration}</span>
      </div>

      <!-- Toggles -->
      <div class="setting-group">
        <label class="setting-label">{ui.common.options}</label>
        <div style="display: flex; flex-direction: column; gap: 0.625rem; margin-top: 0.25rem;">
          <label class="setting-checkbox-item">
            <input type="checkbox" id="check-blank-sync" checked />
            <span>{tool.settingsLabels.cpsLabel}</span>
          </label>
          <span class="setting-hint" style="margin-top: -0.25rem; margin-left: 1.5rem;">
            {tool.settingsLabels.cpsHint}
          </span>

          <label class="setting-checkbox-item" style="margin-top: 0.25rem;">
            <input type="checkbox" id="check-clean-html" />
            <span>{tool.settingsLabels.startTime}</span>
          </label>
          <span class="setting-hint" style="margin-top: -0.25rem; margin-left: 1.5rem;">
            {tool.settingsLabels.startTimeHint}
          </span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { convertSrtToSmi, SAMPLE_SRT_FOR_SMI } from '@/lib/smi-converters';

  function initSrtToSmiTool() {
    const srtInput = document.getElementById('srt-input') as HTMLTextAreaElement | null;
    const smiOutput = document.getElementById('smi-output') as HTMLTextAreaElement | null;
    const fileUpload = document.getElementById('srt-file-upload') as HTMLInputElement | null;
    const dropzone = document.getElementById('srt-dropzone') as HTMLElement | null;
    const btnLoadSample = document.getElementById('btn-load-srt-sample') as HTMLButtonElement | null;
    const btnClear = document.getElementById('btn-clear-srt-input') as HTMLButtonElement | null;
    const btnCopy = document.getElementById('btn-copy-smi') as HTMLButtonElement | null;
    const btnDownload = document.getElementById('btn-download-smi') as HTMLButtonElement | null;
    const copyBtnText = document.getElementById('copy-smi-btn-text') as HTMLElement | null;
    const inputStats = document.getElementById('srt-input-stats') as HTMLElement | null;
    const outputStats = document.getElementById('smi-output-stats') as HTMLElement | null;

    const selectClass = document.getElementById('select-sami-class') as HTMLSelectElement | null;
    const checkBlankSync = document.getElementById('check-blank-sync') as HTMLInputElement | null;
    const checkCleanHtml = document.getElementById('check-clean-html') as HTMLInputElement | null;

    let originalFileName = 'subtitles';

    function doConversion() {
      if (!srtInput || !smiOutput) return;
      const rawText = srtInput.value;

      const rawChars = rawText.length;
      const rawLines = rawText ? rawText.split('\n').length : 0;
      if (inputStats) {
        inputStats.textContent = `${rawLines} lines | ${rawChars} characters`;
      }

      if (!rawText.trim()) {
        smiOutput.value = '';
        if (outputStats) outputStats.textContent = '0 cues | 0 characters';
        if (btnCopy) btnCopy.disabled = true;
        if (btnDownload) btnDownload.disabled = true;
        return;
      }

      const selectedClass = selectClass?.value || 'KRCC';
      const result = convertSrtToSmi(rawText, {
        languageClass: selectedClass,
        includeBlankSyncPoints: checkBlankSync?.checked ?? true,
        cleanHtmlTags: checkCleanHtml?.checked ?? false,
      });

      smiOutput.value = result.smi;

      if (outputStats) {
        outputStats.textContent = `${result.cueCount} cues | ${result.smi.length} characters`;
      }

      const hasContent = Boolean(result.smi && result.smi.trim().length > 0);
      if (btnCopy) btnCopy.disabled = !hasContent;
      if (btnDownload) btnDownload.disabled = !hasContent;
    }

    srtInput?.addEventListener('input', doConversion);
    selectClass?.addEventListener('change', doConversion);
    checkBlankSync?.addEventListener('change', doConversion);
    checkCleanHtml?.addEventListener('change', doConversion);

    btnLoadSample?.addEventListener('click', () => {
      if (!srtInput) return;
      srtInput.value = SAMPLE_SRT_FOR_SMI;
      originalFileName = 'sample_subtitles';
      doConversion();
    });

    btnClear?.addEventListener('click', () => {
      if (srtInput) srtInput.value = '';
      if (fileUpload) fileUpload.value = '';
      originalFileName = 'subtitles';
      doConversion();
    });

    btnCopy?.addEventListener('click', async () => {
      if (!smiOutput || !smiOutput.value) return;
      try {
        await navigator.clipboard.writeText(smiOutput.value);
        if (copyBtnText) {
          const oldText = copyBtnText.textContent;
          copyBtnText.textContent = 'Copied!';
          setTimeout(() => {
            if (copyBtnText) copyBtnText.textContent = oldText;
          }, 2000);
        }
      } catch (err) {
        smiOutput.select();
        document.execCommand('copy');
      }
    });

    btnDownload?.addEventListener('click', () => {
      if (!smiOutput || !smiOutput.value) return;
      const blob = new Blob([smiOutput.value], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${originalFileName.replace(/\.srt$/i, '')}.smi`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });

    function handleFile(file: File) {
      if (!file) return;
      originalFileName = file.name;
      const reader = new FileReader();
      reader.onload = (e) => {
        if (srtInput && e.target?.result) {
          srtInput.value = e.target.result as string;
          doConversion();
        }
      };
      reader.readAsText(file, 'utf-8');
    }

    fileUpload?.addEventListener('change', (e) => {
      const files = (e.target as HTMLInputElement).files;
      if (files && files[0]) {
        handleFile(files[0]);
      }
    });

    if (dropzone) {
      ['dragenter', 'dragover'].forEach((eventName) => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.add('drag-over');
        });
      });

      ['dragleave', 'drop'].forEach((eventName) => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.remove('drag-over');
        });
      });

      dropzone.addEventListener('drop', (e) => {
        const dt = (e as DragEvent).dataTransfer;
        if (dt && dt.files && dt.files.length > 0) {
          handleFile(dt.files[0]);
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSrtToSmiTool);
  } else {
    initSrtToSmiTool();
  }
</script>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .privacy-banner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-left: 4px solid #10b981;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-primary);
  }

  .privacy-banner svg {
    color: #10b981;
    flex-shrink: 0;
  }

  .tool-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .tool-grid {
      grid-template-columns: 1fr;
    }
  }

  .tool-pane {
    display: flex;
    flex-direction: column;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .pane-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border-color);
    background-color: var(--bg-primary);
  }

  .pane-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .pane-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .dropzone-container {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 260px;
  }

  .tool-textarea {
    width: 100%;
    height: 260px;
    padding: 1rem;
    background-color: transparent;
    border: none;
    resize: vertical;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-primary);
    box-sizing: border-box;
    outline: none;
  }

  .tool-textarea:focus {
    outline: none;
  }

  .dropzone-overlay {
    position: absolute;
    bottom: 0.5rem;
    right: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.65rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 0.375rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
    box-shadow: var(--shadow-sm);
    pointer-events: auto;
  }

  .file-input-hidden {
    display: none;
  }

  .pane-footer-counts {
    display: flex;
    justify-content: flex-end;
    padding: 0.35rem 0.75rem 0.5rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
    background-color: var(--bg-card);
    border-top: 1px solid var(--border-color);
  }

  .settings-panel {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 0.75rem;
    padding: 1.25rem;
    box-shadow: var(--shadow-sm);
  }

  .settings-panel-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .settings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .setting-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .setting-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .setting-hint {
    font-size: 0.75rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .setting-checkbox-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    font-size: 0.875rem;
    color: var(--text-primary);
    user-select: none;
  }

  .setting-checkbox-item input[type="checkbox"] {
    cursor: pointer;
    width: 1rem;
    height: 1rem;
    accent-color: var(--accent-primary);
    flex-shrink: 0;
  }

  .setting-select {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    text-overflow: ellipsis;
    white-space: nowrap;
    overflow: hidden;
    box-sizing: border-box;
  }

  @media (max-width: 768px) {
    .tool-textarea {
      height: 180px !important;
      min-height: 160px;
      padding: 0.75rem;
      font-size: 0.8125rem;
      line-height: 1.5;
    }

    .dropzone-container {
      min-height: unset;
    }

    .dropzone-overlay {
      padding: 0.45rem 0.75rem;
      font-size: 0.75rem;
    }

    .pane-header {
      padding: 0.5rem 0.75rem;
    }

    .pane-footer-counts {
      padding: 0.25rem 0.5rem 0;
      font-size: 0.6875rem;
    }

    .setting-select {
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
    }
  }
</style>
