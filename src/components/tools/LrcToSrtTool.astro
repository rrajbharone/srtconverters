---
import type { Locale } from '@/i18n/config';
import { getToolsContent, getUiStrings } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUiStrings(locale);
const tools = getToolsContent(locale);
const tool = tools.lrcToSrt;
---

<div class="tool-workspace" id="lrc-to-srt-app">
  <!-- Privacy Guarantee Alert -->
  <div class="privacy-banner">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
      <path d="M9 12l2 2 4-4"></path>
    </svg>
    <span><strong>{ui.privacyNotice.title}:</strong> {ui.privacyNotice.description}</span>
  </div>

  <div class="tool-grid">
    <!-- Left Pane: LRC Input -->
    <div class="tool-pane">
      <div class="pane-header">
        <span class="pane-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 18V5l12-2v13"></path>
            <circle cx="6" cy="18" r="3"></circle>
            <circle cx="18" cy="16" r="3"></circle>
          </svg>
          LRC Lyrics Input (.lrc)
        </span>
        <div class="pane-actions">
          <button type="button" class="btn btn-outline btn-sm" id="btn-load-lrc-sample">
            {ui.common.loadSample}
          </button>
          <button type="button" class="btn btn-outline btn-sm" id="btn-clear-lrc-input">
            {ui.common.clear}
          </button>
        </div>
      </div>

      <div class="dropzone-container" id="lrc-dropzone">
        <textarea
          id="lrc-input"
          class="tool-textarea"
          placeholder="[ti:Song Title]&#10;[ar:Artist]&#10;[00:05.20]Paste your LRC synchronized lyrics here...&#10;[00:11.80]Or drop an .lrc file directly onto this area!"
          spellcheck="false"
        ></textarea>
        
        <div class="dropzone-overlay">
          <span>{ui.common.dragAndDrop}</span>
          <label for="lrc-file-upload" class="btn btn-secondary btn-sm" style="margin: 0; cursor: pointer;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="17 8 12 3 7 8"></polyline>
              <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
            <span>{ui.common.browseFiles}</span>
          </label>
          <input type="file" id="lrc-file-upload" class="file-input-hidden" accept=".lrc,.txt,text/plain" />
        </div>
      </div>

      <div class="pane-footer-counts">
        <span id="lrc-input-stats">0 lines | 0 characters</span>
      </div>
    </div>

    <!-- Right Pane: SRT Output -->
    <div class="tool-pane">
      <div class="pane-header">
        <span class="pane-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="4 17 10 11 4 5"></polyline>
            <line x1="12" y1="19" x2="20" y2="19"></line>
          </svg>
          SubRip SRT Output (.srt)
        </span>
        <div class="pane-actions">
          <button type="button" class="btn btn-outline btn-sm" id="btn-copy-srt" disabled>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="copy-srt-btn-text">{ui.common.copy}</span>
          </button>
          <button type="button" class="btn btn-primary btn-sm" id="btn-download-srt" disabled>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>{ui.common.download}</span>
          </button>
        </div>
      </div>

      <textarea
        id="srt-output"
        class="tool-textarea"
        readonly
        placeholder="1&#10;00:00:05,200 --> 00:00:10,200&#10;Converted SubRip (.srt) subtitles will appear here...&#10;&#10;2&#10;00:00:11,800 --> 00:00:16,800&#10;Accurate millisecond timestamps and smart cue duration."
      ></textarea>

      <div class="pane-footer-counts">
        <span id="srt-output-stats">0 subtitles | 0 characters</span>
      </div>
    </div>
  </div>

  <!-- Settings Panel -->
  <div class="settings-panel">
    <div class="settings-panel-title">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="3"></circle>
        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
      </svg>
      {tool.settingsLabels.timingMode || ui.common.settings}
    </div>

    <div class="settings-grid">
      <!-- Max Cue Duration -->
      <div class="setting-group">
        <label class="setting-label" for="setting-max-duration">
          {tool.settingsLabels.fixedDuration}
        </label>
        <input type="number" id="setting-max-duration" class="setting-input" value="5" min="2" max="15" step="0.5" />
        <span class="setting-hint">{tool.settingsLabels.cpsDuration}</span>
      </div>

      <!-- Gap Between Cues -->
      <div class="setting-group">
        <label class="setting-label" for="setting-gap-ms">
          {tool.settingsLabels.cpsLabel}
        </label>
        <input type="number" id="setting-gap-ms" class="setting-input" value="50" min="0" max="1000" step="10" />
        <span class="setting-hint">{tool.settingsLabels.cpsHint}</span>
      </div>

      <!-- Checkboxes -->
      <div class="setting-group">
        <label class="setting-label">{ui.common.options}</label>
        <div style="display: flex; flex-direction: column; gap: 0.625rem; margin-top: 0.25rem;">
          <label class="setting-checkbox-item">
            <input type="checkbox" id="check-apply-offset" checked />
            <span>{tool.settingsLabels.startTime}</span>
          </label>
          <span class="setting-hint" style="margin-top: -0.25rem; margin-left: 1.5rem;">
            {tool.settingsLabels.startTimeHint}
          </span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { convertLrcToSrt, SAMPLE_LRC } from '@/lib/lrc-converters';

  function initLrcToSrt() {
    const lrcInput = document.getElementById('lrc-input') as HTMLTextAreaElement;
    const srtOutput = document.getElementById('srt-output') as HTMLTextAreaElement;
    const fileUpload = document.getElementById('lrc-file-upload') as HTMLInputElement;
    const dropzone = document.getElementById('lrc-dropzone');
    const inputStats = document.getElementById('lrc-input-stats');
    const outputStats = document.getElementById('srt-output-stats');
    const btnLoadSample = document.getElementById('btn-load-lrc-sample');
    const btnClear = document.getElementById('btn-clear-lrc-input');
    const btnCopy = document.getElementById('btn-copy-srt') as HTMLButtonElement;
    const btnDownload = document.getElementById('btn-download-srt') as HTMLButtonElement;
    const copyBtnText = document.getElementById('copy-srt-btn-text');

    const settingMaxDuration = document.getElementById('setting-max-duration') as HTMLInputElement;
    const settingGapMs = document.getElementById('setting-gap-ms') as HTMLInputElement;
    const checkApplyOffset = document.getElementById('check-apply-offset') as HTMLInputElement;

    let convertedSrtText = '';

    function processConversion() {
      if (!lrcInput || !srtOutput) return;
      const rawText = lrcInput.value;

      // Update input statistics
      const chars = rawText.length;
      const lines = rawText ? rawText.split('\n').length : 0;
      if (inputStats) {
        inputStats.innerText = `${lines} lines | ${chars} characters`;
      }

      if (!rawText.trim()) {
        convertedSrtText = '';
        srtOutput.value = '';
        if (outputStats) {
          outputStats.innerText = '0 subtitles | 0 characters';
        }
        if (btnCopy) btnCopy.disabled = true;
        if (btnDownload) btnDownload.disabled = true;
        return;
      }

      const maxDur = parseFloat(settingMaxDuration?.value || '5') || 5.0;
      const gapMs = parseInt(settingGapMs?.value || '50', 10) || 50;
      const applyOffset = checkApplyOffset?.checked !== false;

      const result = convertLrcToSrt(rawText, {
        maxDurationSeconds: maxDur,
        gapMs: gapMs,
        applyOffsetTag: applyOffset
      });

      convertedSrtText = result.srt;
      srtOutput.value = result.srt;

      if (outputStats) {
        outputStats.innerText = `${result.cueCount} subtitles | ${result.srt.length} characters`;
      }

      const hasContent = Boolean(result.srt.trim() && result.cueCount > 0);
      if (btnCopy) btnCopy.disabled = !hasContent;
      if (btnDownload) btnDownload.disabled = !hasContent;
    }

    // Event listeners
    lrcInput?.addEventListener('input', processConversion);
    settingMaxDuration?.addEventListener('input', processConversion);
    settingGapMs?.addEventListener('input', processConversion);
    checkApplyOffset?.addEventListener('change', processConversion);

    btnLoadSample?.addEventListener('click', () => {
      if (lrcInput) {
        lrcInput.value = SAMPLE_LRC;
        processConversion();
      }
    });

    btnClear?.addEventListener('click', () => {
      if (lrcInput) {
        lrcInput.value = '';
        if (fileUpload) fileUpload.value = '';
        processConversion();
      }
    });

    fileUpload?.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      const file = target.files?.[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (evt) => {
          if (lrcInput && typeof evt.target?.result === 'string') {
            lrcInput.value = evt.target.result;
            processConversion();
          }
        };
        reader.readAsText(file);
      }
    });

    if (dropzone) {
      ['dragenter', 'dragover'].forEach((ev) => {
        dropzone.addEventListener(ev, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.add('dragover');
        });
      });

      ['dragleave', 'drop'].forEach((ev) => {
        dropzone.addEventListener(ev, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.remove('dragover');
        });
      });

      dropzone.addEventListener('drop', (e: DragEvent) => {
        const files = e.dataTransfer?.files;
        if (files && files.length > 0) {
          const file = files[0];
          const reader = new FileReader();
          reader.onload = (evt) => {
            if (lrcInput && typeof evt.target?.result === 'string') {
              lrcInput.value = evt.target.result;
              processConversion();
            }
          };
          reader.readAsText(file);
        }
      });
    }

    btnCopy?.addEventListener('click', async () => {
      if (!convertedSrtText) return;
      try {
        await navigator.clipboard.writeText(convertedSrtText);
        if (copyBtnText) {
          const orig = copyBtnText.innerText;
          copyBtnText.innerText = 'Copied!';
          setTimeout(() => {
            copyBtnText.innerText = orig;
          }, 2000);
        }
      } catch (err) {
        console.error('Clipboard copy error', err);
      }
    });

    btnDownload?.addEventListener('click', () => {
      if (!convertedSrtText) return;
      const blob = new Blob([convertedSrtText], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'lyrics.srt';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });

    // Auto load sample on first load if input is empty
    if (lrcInput && !lrcInput.value.trim()) {
      lrcInput.value = SAMPLE_LRC;
      processConversion();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLrcToSrt);
  } else {
    initLrcToSrt();
  }
</script>

<style>
  .tool-workspace {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .privacy-banner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .privacy-banner svg {
    color: var(--accent-primary);
    flex-shrink: 0;
  }

  .tool-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .tool-grid {
      grid-template-columns: 1fr;
    }
  }

  .tool-pane {
    display: flex;
    flex-direction: column;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .pane-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background-color: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
  }

  .pane-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .pane-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .dropzone-container {
    position: relative;
    width: 100%;
    min-height: 260px;
    display: flex;
    flex-direction: column;
  }

  .dropzone-container.dragover {
    border: 2px dashed var(--accent-primary);
  }

  .tool-textarea {
    width: 100%;
    height: 260px;
    padding: 1rem;
    font-family: 'Fira Code', 'Cascadia Code', monospace;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-primary);
    background-color: var(--bg-card);
    border: none;
    resize: none;
    outline: none;
    white-space: pre;
    overflow-y: auto;
  }

  .dropzone-overlay {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    padding: 0.5rem 1rem;
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .file-input-hidden {
    display: none;
  }

  .pane-footer-counts {
    display: flex;
    justify-content: flex-end;
    padding: 0.4rem 0.8rem;
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .settings-panel {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    box-shadow: var(--shadow-sm);
  }

  .settings-panel-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-color);
  }

  .settings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }

  .setting-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .setting-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .setting-input {
    width: 100%;
    padding: 0.5rem 0.75rem;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-size: 0.875rem;
    outline: none;
    transition: border-color var(--transition-fast);
  }

  .setting-input:focus {
    border-color: var(--accent-primary);
  }

  .setting-hint {
    font-size: 0.75rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .setting-checkbox-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    font-size: 0.875rem;
    color: var(--text-primary);
    user-select: none;
  }

  .setting-checkbox-item input[type="checkbox"] {
    cursor: pointer;
    width: 1rem;
    height: 1rem;
    accent-color: var(--accent-primary);
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .tool-textarea {
      height: 180px !important;
      min-height: 160px;
      padding: 0.75rem;
      font-size: 0.8125rem;
      line-height: 1.5;
    }

    .dropzone-container {
      min-height: unset;
    }

    .dropzone-overlay {
      padding: 0.45rem 0.75rem;
      font-size: 0.75rem;
    }

    .pane-header {
      padding: 0.5rem 0.75rem;
    }

    .pane-footer-counts {
      padding: 0.25rem 0.5rem 0;
      font-size: 0.6875rem;
    }
  }
</style>
