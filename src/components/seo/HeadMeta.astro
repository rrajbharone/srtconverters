---
import { type Locale, LOCALE_INFO, DEFAULT_LOCALE } from '@/i18n/config';
import { type RouteId, getRoutePath, getAlternateLinks } from '@/i18n/routes';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  routeId: RouteId | '404' | 'legal';
  ogType?: 'website' | 'article';
  publishedTime?: string;
  author?: string;
  canonicalUrl?: string;
  noAlternates?: boolean;
}

const {
  title,
  description,
  locale,
  routeId,
  ogType = 'website',
  publishedTime,
  author,
  canonicalUrl: customCanonicalUrl,
  noAlternates = false,
} = Astro.props;

const siteUrl = 'https://srtconverters.com';
const currentPath = routeId !== '404' && routeId !== 'legal' ? getRoutePath(routeId, locale) : Astro.url.pathname;
const canonicalUrl = customCanonicalUrl || `${siteUrl}${currentPath}`;
const alternates = !noAlternates && routeId !== '404' && routeId !== 'legal' ? getAlternateLinks(routeId, siteUrl) : [];
const localeInfo = LOCALE_INFO[locale] || LOCALE_INFO[DEFAULT_LOCALE];
---

<!-- Primary Meta Tags -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="generator" content={Astro.generator} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

<!-- Preload Inter Self-Hosted Font for Peak Performance -->
<link rel="preload" href="/fonts/inter-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

<!-- Canonical Tag -->
<link rel="canonical" href={canonicalUrl} />

<!-- Hreflang Alternates (All 8 Locales + x-default) -->
{alternates.map((alt) => (
  <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
))}

<!-- Favicon and App Icons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="theme-color" content="#2563eb" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="SRTConverters" />
<meta property="og:locale" content={localeInfo.isoCode.replace('-', '_')} />
{ogType === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{ogType === 'article' && author && (
  <meta property="article:author" content={author} />
)}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />

<!-- Anti-Theme Flash Inline Script -->
<script is:inline>
  (function () {
    try {
      const storedTheme = localStorage.getItem('srtconverters_theme');
      if (storedTheme === 'dark' || (!storedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.setAttribute('data-theme', 'dark');
      } else {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    } catch (e) {}
  })();
</script>
