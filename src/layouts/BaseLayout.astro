---
import '@/styles/global.css';
import { type Locale, LOCALE_INFO, DEFAULT_LOCALE } from '@/i18n/config';
import type { RouteId } from '@/i18n/routes';
import HeadMeta from '@/components/seo/HeadMeta.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  routeId: RouteId | '404' | 'legal';
  ogType?: 'website' | 'article';
  publishedTime?: string;
  author?: string;
  jsonLdType?: 'website' | 'webApplication' | 'article';
  toolData?: {
    name: string;
    description: string;
    applicationCategory: string;
  };
  articleData?: {
    title: string;
    description: string;
    publishDate: string;
    author: string;
  };
  breadcrumbs?: Array<{ name?: string; label?: string; url: string }>;
  faqs?: Array<{ question: string; answer: string }>;
  showLanguageSwitcher?: boolean;
  canonicalUrl?: string;
  noAlternates?: boolean;
}

const {
  title,
  description,
  locale,
  routeId,
  ogType = 'website',
  publishedTime,
  author,
  jsonLdType = 'website',
  toolData,
  articleData,
  breadcrumbs,
  faqs,
  showLanguageSwitcher = true,
  canonicalUrl,
  noAlternates = false,
} = Astro.props;

const localeInfo = LOCALE_INFO[locale] || LOCALE_INFO[DEFAULT_LOCALE];
---

<!doctype html>
<html lang={locale} dir={localeInfo.dir}>
  <head>
    <HeadMeta
      title={title}
      description={description}
      locale={locale}
      routeId={routeId}
      ogType={ogType}
      publishedTime={publishedTime}
      author={author}
      canonicalUrl={canonicalUrl}
      noAlternates={noAlternates}
    />
    <JsonLd
      locale={locale}
      routeId={routeId}
      type={jsonLdType}
      toolData={toolData}
      articleData={articleData}
      breadcrumbs={breadcrumbs?.map(b => ({ name: b.name || b.label || '', url: b.url }))}
      faqs={faqs}
    />
  </head>
  <body>
    <Header locale={locale} routeId={routeId} showLanguageSwitcher={showLanguageSwitcher} />
    <main id="main-content">
      <slot />
    </main>
    <Footer locale={locale} />

    {/* Optional Cloudflare Web Analytics (loaded with defer right before closing body) */}
    {import.meta.env.PUBLIC_CF_BEACON_TOKEN && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: import.meta.env.PUBLIC_CF_BEACON_TOKEN })}
      ></script>
    )}
  </body>
</html>
