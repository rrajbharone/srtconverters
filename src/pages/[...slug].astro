---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ToolLayout from '@/layouts/ToolLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import TxtToSrtTool from '@/components/tools/TxtToSrtTool.astro';
import SrtToTextTool from '@/components/tools/SrtToTextTool.astro';
import SrtToVttTool from '@/components/tools/SrtToVttTool.astro';
import VttToSrtTool from '@/components/tools/VttToSrtTool.astro';
import SrtToAssTool from '@/components/tools/SrtToAssTool.astro';
import AssToSrtTool from '@/components/tools/AssToSrtTool.astro';
import SrtToSubTool from '@/components/tools/SrtToSubTool.astro';
import SubToSrtTool from '@/components/tools/SubToSrtTool.astro';
import SbvToSrtTool from '@/components/tools/SbvToSrtTool.astro';
import SmiToSrtTool from '@/components/tools/SmiToSrtTool.astro';
import SrtToSmiTool from '@/components/tools/SrtToSmiTool.astro';
import LrcToSrtTool from '@/components/tools/LrcToSrtTool.astro';
import SupToSrtTool from '@/components/tools/SupToSrtTool.astro';
import ToolCard from '@/components/tools/ToolCard.astro';
import { ROUTES, type RouteId, getRoutePath } from '@/i18n/routes';
import { type Locale } from '@/i18n/config';
import { getToolsContent, getUiStrings, getPageSeo } from '@/i18n/utils';

export async function getStaticPaths() {
  const paths = [];

  for (const [routeId, locMap] of Object.entries(ROUTES)) {
    for (const [locale, rawPath] of Object.entries(locMap)) {
      const cleanPath = rawPath.replace(/^\//, '').replace(/\/$/, '');
      const slug = cleanPath === '' ? undefined : cleanPath;
      paths.push({
        params: { slug },
        props: { routeId: routeId as RouteId, locale: locale as Locale },
      });
    }
  }

  return paths;
}

interface Props {
  routeId: RouteId;
  locale: Locale;
}

const { routeId, locale } = Astro.props;

const ui = getUiStrings(locale);
const tools = getToolsContent(locale);
const seo = getPageSeo(routeId, locale);

const homeUrl = getRoutePath('home', locale);
const toolsUrl = getRoutePath('tools', locale);
---

{routeId === 'home' && (
  <BaseLayout
    title={seo.title}
    description={seo.description}
    locale={locale}
    routeId={routeId}
    jsonLdType="webApplication"
    toolData={{
      name: tools.txtToSrt.name,
      description: seo.description,
      applicationCategory: 'MultimediaApplication',
    }}
    faqs={tools.txtToSrt.faqs}
  >
    <div class="container" style="padding-top: 1.5rem;">
      <section class="hero-section">
        <div class="hero-badges">
          <span class="badge badge-success">{tools.txtToSrt.badge}</span>
          <span class="badge">{ui.footer.privacyBadge}</span>
        </div>
        <h1 class="hero-title">{tools.txtToSrt.h1}</h1>
        <p class="hero-subtitle">{tools.txtToSrt.tagline}</p>
      </section>

      <!-- Primary Converter Tool on Homepage -->
      <TxtToSrtTool locale={locale} />

      <!-- Step-by-Step Instructions -->
      {tools.txtToSrt.steps && (
        <section class="info-section">
          <div class="section-heading">
            <h2 class="section-title">{tools.txtToSrt.stepsTitle}</h2>
          </div>
          <div class="steps-grid">
            {tools.txtToSrt.steps.map((s) => (
              <div class="step-card">
                <div class="step-number">{s.step}</div>
                <h3 class="step-title">{s.title}</h3>
                <p class="step-desc">{s.description}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Popular SRT Tools Section (Directly Below How-To Steps) -->
      <section class="info-section">
        <div class="section-heading">
          <h2 class="section-title">{ui.common.popularTools}</h2>
          <p class="section-subtitle">{ui.common.popularToolsSubtitle}</p>
        </div>
        <div class="tool-cards-grid">
          <ToolCard
            locale={locale}
            routeId="srt-to-text"
            name={tools.srtToText.name}
            badge={tools.srtToText.badge}
            description={tools.srtToText.description}
          />
          <ToolCard
            locale={locale}
            routeId="vtt-to-srt"
            name={tools.vttToSrt.name}
            badge={tools.vttToSrt.badge}
            description={tools.vttToSrt.description}
          />
          <ToolCard
            locale={locale}
            routeId="ass-to-srt"
            name={tools.assToSrt.h1}
            badge={tools.assToSrt.badge}
            description={tools.assToSrt.description}
          />
          <ToolCard
            locale={locale}
            routeId="sub-to-srt"
            name={tools.subToSrt.h1}
            badge={tools.subToSrt.badge}
            description={tools.subToSrt.description}
          />
        </div>
      </section>

      <!-- Key Features Section -->
      {tools.txtToSrt.features && (
        <section class="info-section">
          <div class="section-heading">
            <h2 class="section-title">{tools.txtToSrt.featuresTitle}</h2>
          </div>
          <div class="features-grid">
            {tools.txtToSrt.features.map((f) => (
              <div class="feature-card">
                <div class="feature-icon">
                  {f.icon === 'shield' && (
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                  )}
                  {f.icon === 'split' && (
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <line x1="4" y1="6" x2="20" y2="6"></line>
                      <line x1="4" y1="12" x2="14" y2="12"></line>
                      <line x1="4" y1="18" x2="18" y2="18"></line>
                    </svg>
                  )}
                  {f.icon === 'clock' && (
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                  )}
                  {f.icon === 'file' && (
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                      <polyline points="14 2 14 8 20 8"></polyline>
                    </svg>
                  )}
                </div>
                <h3 class="feature-title">{f.title}</h3>
                <p class="feature-desc">{f.description}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- FAQ Accordion -->
      {tools.txtToSrt.faqs && (
        <section class="info-section">
          <div class="section-heading">
            <h2 class="section-title">{tools.txtToSrt.faqsTitle}</h2>
          </div>
          <div class="faq-list">
            {tools.txtToSrt.faqs.map((faq) => (
              <details class="faq-item">
                <summary class="faq-question">
                  <span>{faq.question}</span>
                  <svg class="faq-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </summary>
                <div class="faq-answer">
                  <p>{faq.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </section>
      )}
    </div>
  </BaseLayout>
)}

{routeId === 'txt-to-srt' && (
  <ToolLayout locale={locale} routeId={routeId} tool={tools.txtToSrt}>
    <TxtToSrtTool locale={locale} />
  </ToolLayout>
)}

{routeId === 'srt-to-text' && (
  <ToolLayout locale={locale} routeId={routeId} tool={tools.srtToText}>
    <SrtToTextTool locale={locale} />
  </ToolLayout>
)}

{routeId === 'srt-to-vtt' && (
  <ToolLayout locale={locale} routeId={routeId} tool={tools.srtToVtt}>
    <SrtToVttTool locale={locale} />
  </ToolLayout>
)}

{routeId === 'vtt-to-srt' && (
  <ToolLayout locale={locale} routeId={routeId} tool={tools.vttToSrt}>
    <VttToSrtTool locale={locale} />
  </ToolLayout>
)}

{routeId === 'srt-to-ass' && (
  <ToolLayout locale={locale} routeId={routeId} tool={tools.srtToAss}>
    <SrtToAssTool locale={locale} />
  </ToolLayout>
)}

{routeId === 'ass-to-srt' && (
  <ToolLayout locale={locale} routeId={routeId} tool={tools.assToSrt}>
    <AssToSrtTool locale={locale} />
  </ToolLayout>
)}

{routeId === 'srt-to-sub' && (
  <ToolLayout locale={locale} routeId={routeId} tool={tools.srtToSub}>
    <SrtToSubTool locale={locale} />
  </ToolLayout>
)}

{routeId === 'sub-to-srt' && (
  <ToolLayout locale={locale} routeId={routeId} tool={tools.subToSrt}>
    <SubToSrtTool locale={locale} />
  </ToolLayout>
)}

{routeId === 'sbv-to-srt' && (
  <ToolLayout locale={locale} routeId={routeId} tool={tools.sbvToSrt}>
    <SbvToSrtTool locale={locale} />
  </ToolLayout>
)}

{routeId === 'smi-to-srt' && (
  <ToolLayout locale={locale} routeId={routeId} tool={tools.smiToSrt}>
    <SmiToSrtTool locale={locale} />
  </ToolLayout>
)}

{routeId === 'srt-to-smi' && (
  <ToolLayout locale={locale} routeId={routeId} tool={tools.srtToSmi}>
    <SrtToSmiTool locale={locale} />
  </ToolLayout>
)}

{routeId === 'lrc-to-srt' && (
  <ToolLayout locale={locale} routeId={routeId} tool={tools.lrcToSrt}>
    <LrcToSrtTool locale={locale} />
  </ToolLayout>
)}

{routeId === 'sup-to-srt' && (
  <ToolLayout locale={locale} routeId={routeId} tool={tools.supToSrt}>
    <SupToSrtTool locale={locale} />
  </ToolLayout>
)}

{routeId === 'tools' && (
  <BaseLayout
    title={seo.title}
    description={seo.description}
    locale={locale}
    routeId={routeId}
    breadcrumbs={[
      { label: ui.nav.home, url: homeUrl },
      { label: ui.nav.tools, url: toolsUrl },
    ]}
  >
    <div class="container" style="padding-top: 1.5rem;">
      <Breadcrumbs
        items={[
          { label: ui.nav.home, url: homeUrl },
          { label: ui.nav.tools, url: toolsUrl },
        ]}
      />

      <section class="hero-section">
        <div class="hero-badges">
          <span class="badge badge-success">{tools.directory.clientSideBadge}</span>
        </div>
        <h1 class="hero-title">{tools.directory.title}</h1>
        <p class="hero-subtitle">{tools.directory.subtitle}</p>
      </section>

      <!-- Prominent Tool Search Bar -->
      <div class="tools-search-wrapper" role="search">
        <div class="tools-search-box">
          <div class="tools-search-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </div>
          <input
            type="search"
            id="tool-search-input"
            class="tools-search-input"
            placeholder={ui.common.searchToolsPlaceholder}
            aria-label={ui.common.searchToolsPlaceholder}
            autocomplete="off"
            spellcheck="false"
          />
          <button
            type="button"
            id="tool-search-clear"
            class="tools-search-clear"
            aria-label={ui.common.clearSearch}
            title={ui.common.clearSearch}
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <div class="tools-search-stats" id="tools-search-stats" data-tools-found={ui.common.toolsFound}></div>
      </div>

      <!-- No Results State -->
      <div class="tools-no-results" id="tools-no-results" role="status" aria-live="polite">
        <div class="tools-no-results-icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
        </div>
        <h3 class="tools-no-results-title">{ui.common.noToolsFound}</h3>
        <p class="tools-no-results-desc">{ui.common.noToolsFoundDesc}</p>
        <button type="button" class="btn btn-primary btn-sm" id="tools-reset-search">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="1 4 1 10 7 10"></polyline>
            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
          </svg>
          <span>{ui.common.viewAllTools}</span>
        </button>
      </div>

      <!-- Tools Categories & Cards -->
      <section data-category-section style="margin-bottom: 3.5rem;">
        <h2 style="font-size: 1.5rem; font-weight: 800; margin-bottom: 1.5rem; color: var(--text-primary);">
          {tools.directory.convertersCategory}
        </h2>
        <div class="tool-cards-grid">
          <ToolCard
            locale={locale}
            routeId="txt-to-srt"
            name={tools.txtToSrt.name}
            badge={tools.txtToSrt.badge}
            description={tools.txtToSrt.description}
            keywords="txt text srt subrip plain text transcript subtitles"
          />
          <ToolCard
            locale={locale}
            routeId="srt-to-text"
            name={tools.srtToText.name}
            badge={tools.srtToText.badge}
            description={tools.srtToText.description}
            keywords="srt text txt transcript plain text strip timestamps captions"
          />
          <ToolCard
            locale={locale}
            routeId="srt-to-vtt"
            name={tools.srtToVtt.name}
            badge={tools.srtToVtt.badge}
            description={tools.srtToVtt.description}
            keywords="srt vtt webvtt html5 video web captions subtitles"
          />
          <ToolCard
            locale={locale}
            routeId="vtt-to-srt"
            name={tools.vttToSrt.name}
            badge={tools.vttToSrt.badge}
            description={tools.vttToSrt.description}
            keywords="vtt srt webvtt subrip video captions subtitles"
          />
          <ToolCard
            locale={locale}
            routeId="srt-to-ass"
            name={tools.srtToAss.name}
            badge={tools.srtToAss.badge}
            description={tools.srtToAss.description}
            keywords="srt ass ssa substation alpha styles anime formatting"
          />
          <ToolCard
            locale={locale}
            routeId="ass-to-srt"
            name={tools.assToSrt.name}
            badge={tools.assToSrt.badge}
            description={tools.assToSrt.description}
            keywords="ass srt ssa substation alpha clean tags anime subtitles"
          />
          <ToolCard
            locale={locale}
            routeId="srt-to-sub"
            name={tools.srtToSub.name}
            badge={tools.srtToSub.badge}
            description={tools.srtToSub.description}
            keywords="srt sub microdvd subviewer fps frames timing"
          />
          <ToolCard
            locale={locale}
            routeId="sub-to-srt"
            name={tools.subToSrt.name}
            badge={tools.subToSrt.badge}
            description={tools.subToSrt.description}
            keywords="sub srt microdvd subviewer fps frames milliseconds"
          />
          <ToolCard
            locale={locale}
            routeId="sbv-to-srt"
            name={tools.sbvToSrt.name}
            badge={tools.sbvToSrt.badge}
            description={tools.sbvToSrt.description}
            keywords="sbv srt youtube google captions video subrip"
          />
          <ToolCard
            locale={locale}
            routeId="smi-to-srt"
            name={tools.smiToSrt.name}
            badge={tools.smiToSrt.badge}
            description={tools.smiToSrt.description}
            keywords="smi sami srt sync windows media player"
          />
          <ToolCard
            locale={locale}
            routeId="srt-to-smi"
            name={tools.srtToSmi.name}
            badge={tools.srtToSmi.badge}
            description={tools.srtToSmi.description}
            keywords="srt smi sami sync windows media player"
          />
          <ToolCard
            locale={locale}
            routeId="lrc-to-srt"
            name={tools.lrcToSrt.name}
            badge={tools.lrcToSrt.badge}
            description={tools.lrcToSrt.description}
            keywords="lrc srt lyrics song music audio synchronized"
          />
          <ToolCard
            locale={locale}
            routeId="sup-to-srt"
            name={tools.supToSrt.name}
            badge={tools.supToSrt.badge}
            description={tools.supToSrt.description}
            keywords="sup bluray pgs ocr bitmap image subtitles to text subrip"
          />
        </div>
      </section>
    </div>

    <!-- Interactive Tools Search Filter Script -->
    <script is:inline>
      (function () {
        const searchInput = document.getElementById('tool-search-input');
        const clearBtn = document.getElementById('tool-search-clear');
        const noResults = document.getElementById('tools-no-results');
        const resetBtn = document.getElementById('tools-reset-search');
        const categorySections = document.querySelectorAll('[data-category-section]');
        const cards = document.querySelectorAll('[data-tool-card]');
        const statsEl = document.getElementById('tools-search-stats');

        if (!searchInput || !cards.length) return;

        function filterTools() {
          const rawQuery = searchInput.value || '';
          const normalized = rawQuery.trim().toLowerCase().replace(/\s+/g, ' ');

          // Toggle clear button
          if (clearBtn) {
            clearBtn.style.display = rawQuery.length > 0 ? 'flex' : 'none';
          }

          const terms = normalized.split(' ').filter(Boolean);
          let totalVisible = 0;

          cards.forEach((card) => {
            if (terms.length === 0) {
              card.style.display = '';
              totalVisible++;
              return;
            }
            const text = (card.getAttribute('data-search-text') || '').toLowerCase();
            const matches = terms.every((term) => text.includes(term));
            if (matches) {
              card.style.display = '';
              totalVisible++;
            } else {
              card.style.display = 'none';
            }
          });

          // Show/hide category sections based on visible cards
          categorySections.forEach((section) => {
            const sectionCards = section.querySelectorAll('[data-tool-card]');
            const hasVisible = Array.from(sectionCards).some((c) => c.style.display !== 'none');
            section.style.display = hasVisible ? '' : 'none';
          });

          // Toggle No Results state
          if (noResults) {
            if (totalVisible === 0 && terms.length > 0) {
              noResults.style.display = 'block';
            } else {
              noResults.style.display = 'none';
            }
          }

          // Update stats text
          if (statsEl) {
            if (terms.length > 0) {
              statsEl.style.display = 'block';
              const label = statsEl.getAttribute('data-tools-found') || 'tools found';
              statsEl.textContent = totalVisible + ' ' + label;
            } else {
              statsEl.style.display = 'none';
            }
          }
        }

        function resetSearch() {
          searchInput.value = '';
          filterTools();
          searchInput.focus();
        }

        searchInput.addEventListener('input', filterTools);
        searchInput.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            resetSearch();
          }
        });

        if (clearBtn) {
          clearBtn.addEventListener('click', resetSearch);
        }
        if (resetBtn) {
          resetBtn.addEventListener('click', resetSearch);
        }
      })();
    </script>
  </BaseLayout>
)}
