---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getUiStrings } from '@/i18n/utils';

const ui = getUiStrings('en');
---

<BaseLayout
  title="Page Not Found (404) | SRTConverters"
  description="The page you requested could not be found."
  locale="en"
  routeId="404"
>
  <div class="container" style="padding: 5rem 1.25rem; text-align: center;">
    <span class="badge" style="font-size: 1rem; padding: 0.5rem 1rem; margin-bottom: 1.5rem;">404</span>
    <h1 class="hero-title">{ui.common.notFoundTitle}</h1>
    <p class="hero-subtitle" style="margin-bottom: 2rem;">{ui.common.notFoundDesc}</p>
    <a href="/" class="btn btn-primary">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
        <polyline points="9 22 9 12 15 12 15 22"></polyline>
      </svg>
      <span>{ui.common.goHome}</span>
    </a>
  </div>
</BaseLayout>
